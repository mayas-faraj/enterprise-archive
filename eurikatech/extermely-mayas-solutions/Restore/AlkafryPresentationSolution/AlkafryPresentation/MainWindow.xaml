<Window x:Class="AlkafryPresentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="8*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/AlkafryPresentation;component/Images/background1.jpg" />
        </Grid.Background>
        <ContentControl Grid.Row="1" Name="main" Margin="5" Loaded="main_Loaded" />
    </Grid>
</Window>
