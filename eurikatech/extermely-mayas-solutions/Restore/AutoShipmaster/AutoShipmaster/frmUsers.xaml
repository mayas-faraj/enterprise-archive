<Window x:Class="AutoShipmaster.frmUsers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource ResourceKey=background}"
        FlowDirection="RightToLeft"
        Title="المستخدمين" Height="480" Width="640" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.ColumnSpan="3" Grid.Row="0" Foreground="{StaticResource ResourceKey=captions}" FontSize="35" FontWeight="Bold" Text="المستخدمين" TextAlignment="Center"/>
        
        <TextBlock Grid.Column="0" Grid.Row="1" Foreground="{StaticResource ResourceKey=textBlockes}" Text="أسم المستخدم" TextAlignment="Center" Margin="10"/>
        <TextBox Grid.Column="1" Grid.Row="1" Name="txName" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Foreground="{StaticResource ResourceKey=textBlockes}" Text="كلمة المرور" TextAlignment="Center" Margin="10"/>
        <PasswordBox Grid.Column="1" Grid.Row="2" Name="txPassword" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10"/>

        <TextBlock Grid.Column="0" Grid.Row="3" Foreground="{StaticResource ResourceKey=textBlockes}" Text="تأكيد كلمة المرور" TextAlignment="Center" Margin="10"/>
        <PasswordBox Grid.Column="1" Grid.Row="3" Name="txPassword2" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10"/>

        <ListBox Grid.Column="2" Grid.Row="1" Name="lsUsers" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Grid.RowSpan="5" Margin="10" SelectionChanged="lsUsers_SelectionChanged" />
        
        <Grid Grid.ColumnSpan="2" Grid.Row="5" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Name="btnNew" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBoxes}" Margin="5" Content="جديد" Click="btnNew_Click" />
            <Button Grid.Column="1" Name="btnAdd" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBoxes}" Margin="5" Content="إضافة" Click="btnAdd_Click" />
            <Button Grid.Column="2" Name="btnEdit" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBoxes}" Margin="5" Content="تعديل" Click="btnEdit_Click" />
            <Button Grid.Column="3" Name="btnDelete" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBoxes}" Margin="5" Content="حذف" Click="btnDelete_Click" />
            <Button Grid.Column="4" Name="btnBack" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBoxes}" Margin="5" Content="عودة" Click="btnBack_Click" />
        </Grid>
    </Grid>
</Window>
