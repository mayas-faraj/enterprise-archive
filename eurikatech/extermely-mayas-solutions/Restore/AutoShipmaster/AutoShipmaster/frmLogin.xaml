<Window x:Class="AutoShipmaster.frmLogin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource ResourceKey=background}"
        WindowStartupLocation="CenterScreen"
        Title="تسجيل الدخول" Height="200" Width="500" MinHeight="200" MinWidth="500" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Grid.Row="0" Margin="4" TextAlignment="Center" Text="التحكم الآلي عن بعد , مرحبا بك..." Foreground="{StaticResource ResourceKey=captions}" FontSize="22" FontWeight="ExtraBold"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Margin="4" Text="الأسم" Foreground="{StaticResource ResourceKey=textBlockes}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Margin="4" Name="txName" Background="{StaticResource ResourceKey=textBoxes}" Foreground="{StaticResource ResourceKey=texts}"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Margin="4" Text="كلمة المرور" Foreground="{StaticResource ResourceKey=textBlockes}"/>
        <PasswordBox Grid.Column="1" Grid.Row="2" Margin="4" Name="txPassword" Background="{StaticResource ResourceKey=textBoxes}" ForceCursor="True" Foreground="{StaticResource ResourceKey=texts}"/>

        <TextBlock Grid.Column="0" Grid.Row="3" Margin="4" Text="مصدر البيانات" Foreground="{StaticResource ResourceKey=textBlockes}"/>
        <ComboBox Grid.Column="1" Grid.Row="3" Margin="4" Name="cbDataSource" Background="{StaticResource ResourceKey=textBoxes}" Text=".\SQLEXPRESS" DropDownOpened="cbDataSource_DropDownOpened" />
        
        <Grid Grid.ColumnSpan="2" Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="4" Name="btnLogin" Content="تسجيل الدخول" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBlockes}" Click="btnLogin_Click" />
            <Button Grid.Column="1" Margin="4" Name="btnExit" Content="خــــــــروج" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBlockes}" Click="btnExit_Click" />
        </Grid>
    </Grid>
</Window>
