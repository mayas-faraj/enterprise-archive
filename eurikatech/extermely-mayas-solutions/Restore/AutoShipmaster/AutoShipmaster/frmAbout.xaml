<Window x:Class="AutoShipmaster.frmAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource ResourceKey=background}"
        FlowDirection="RightToLeft"
        Title="عن البرنامج" Height="480" Width="640" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="9*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.ColumnSpan="2" Grid.Row="0" Foreground="{StaticResource ResourceKey=captions}" Text="الملاحة الآلية" FontSize="36" FontWeight="Bold" TextAlignment="Center"/>
        
        <Image Grid.Column="2" Grid.Row="1" Source="/AutoShipmaster;component/bin/Debug/Items/maniyat.gif" />
        <StackPanel Grid.Column="0" Grid.Row="1" Margin="5">
            <TextBlock Text="الدكتور المشرف" FontSize="20" Foreground="Yellow" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="الدكتور المهندس سمير كرمان" Foreground="{StaticResource ResourceKey=texts}" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="إعداد الطلاب" FontSize="20" Foreground="Yellow" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="مياس فرج" Foreground="{StaticResource ResourceKey=texts}" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="معمر أرناؤط" Foreground="{StaticResource ResourceKey=texts}" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="محمد زاهر القطشة" Foreground="{StaticResource ResourceKey=texts}" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="شكر خاص" FontSize="20" Foreground="Yellow" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="المهندسة دلال التكريتي" Foreground="{StaticResource ResourceKey=texts}" Margin="5" TextAlignment="Center"/>
            <TextBlock Text="الدكتور نديم شاهين" Foreground="{StaticResource ResourceKey=texts}" Margin="5" TextAlignment="Center"/>
        </StackPanel>

        <Button Grid.ColumnSpan="2" Grid.Row="2" Name="btnBack" Content="عودة" Margin="6" Width="200" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBlockes}" Click="btnBack_Click" /> 
    </Grid>
</Window>

    