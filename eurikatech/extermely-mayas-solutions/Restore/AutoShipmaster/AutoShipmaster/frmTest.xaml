<Window x:Class="AutoShipmaster.frmTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="15"
        Title="Auto ShipMaster Project" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>   
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="Red" Offset="0"/>
                <GradientStop Color="Navy" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <TextBlock Name="txMain" Grid.ColumnSpan="2" Grid.Row="0" Margin="10" Text="Mayas Project" FontFamily="Impact" FontSize="40" TextAlignment="Center" Foreground="Yellow"/>

        <TextBlock Grid.Column="0" Grid.Row="1" Text="ConnectionString" Margin="20"/>
        <TextBox Name="txConnection" Grid.Column="1" Grid.Row="1" Margin="20" Text=""/>
        
        <TextBlock Grid.Column="0" Grid.Row="2" Text="Order Id" Margin="20"/>
        <TextBox Name="txId" Grid.Column="1" Grid.Row="2" Margin="20"/>


        <TextBlock Grid.Column="0" Grid.Row="3" Text="Velocity" Margin="20"/>
        <TextBox Name="txVelocity" Grid.Column="1" Grid.Row="3" Margin="20"/>

        <TextBlock Grid.Column="0" Grid.Row="4" Text="Distance" Margin="20"/>
        <TextBox Name="txDistance" Grid.Column="1" Grid.Row="4" Margin="20" KeyDown="txNumeric_KeyDown" />

        <TextBlock Grid.Column="0" Grid.Row="5" Text="Angle" Margin="20"/>
        <TextBox Name="txAngle" Grid.Column="1" Grid.Row="5" Margin="20" KeyDown="txNumeric_KeyDown" />

        <TextBlock Grid.Column="0" Grid.Row="6" Text="Order Number" Margin="20"/>
        <TextBox Name="txOrderNumber" Grid.Column="1" Grid.Row="6" Margin="20" KeyDown="txInteger_KeyDown" />
        
        <Button Name="btnRun" Grid.ColumnSpan="2" Grid.Row="7" Content="Run" Margin="20" Click="btnRun_Click" />
        
        <ScrollViewer Grid.Row="8" Grid.ColumnSpan="2" Background="red" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <Canvas ScrollViewer.CanContentScroll="True" Width="1000">
            <Image Width="200" Height="300" Source="/AutoShipmaster;component/bin/Debug/Items/200801025_1.jpg" Stretch="Fill" />
            </Canvas>
        </ScrollViewer>
    </Grid>
</Window>
