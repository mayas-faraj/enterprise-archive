<Window x:Class="ClientApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="638" Width="620" Background="Black" FlowDirection="LeftToRight">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="0" BorderThickness="5" CornerRadius="20" Background="Black">
            <Border.BorderBrush>
                <LinearGradientBrush>
                    <GradientStop Color="LightGreen" Offset="1"/>
                    <GradientStop Color="Pink" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        <ScrollViewer Name="scViewer1" Margin="8">
            <ScrollViewer.Background>
                <LinearGradientBrush>
                    <GradientStopCollection>
                        <GradientStop Color="Yellow" Offset="1"/>
                        <GradientStop Color="Blue" Offset="0"/>
                    </GradientStopCollection>
                </LinearGradientBrush>
            </ScrollViewer.Background>
        </ScrollViewer>
        </Border>
        <Border Grid.Column="1" Margin="0" BorderThickness="5" CornerRadius="20" Background="Black">
            <Border.BorderBrush>
                <LinearGradientBrush>
                    <GradientStop Color="Pink" Offset="1"/>
                    <GradientStop Color="LightGreen" Offset="0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
        <ScrollViewer Name="scViewer2" Margin="8">
            <ScrollViewer.Background>
                <LinearGradientBrush>
                    <GradientStopCollection>
                        <GradientStop Color="Yellow" Offset="1"/>
                        <GradientStop Color="Blue" Offset="0"/>
                    </GradientStopCollection>
                </LinearGradientBrush>
            </ScrollViewer.Background>
        </ScrollViewer>
        </Border>
    </Grid>
</Window>
