<Window x:Class="ClientApplicaiton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450"
         Width="1000">
    <Window.Resources>
        <LinearGradientBrush x:Key="lgbBY">
            <GradientStop Color="Blue" Offset="0"/>
            <GradientStop Color="Yellow" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="lgbRB">
            <GradientStop Color="Red" Offset="0"/>
            <GradientStop Color="Black" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="rgbBS">
            <GradientStop Color="Silver" Offset="0"/>
            <GradientStop Color="Black" Offset="1"/>
        </RadialGradientBrush>
    </Window.Resources>
    <Grid Background="{StaticResource ResourceKey=lgbRB}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ContentControl Grid.Column="0" Grid.Row="0">
            <Border Name="borderInput" BorderThickness="4" CornerRadius="20" BorderBrush="{StaticResource ResourceKey=lgbBY}" Background="{StaticResource ResourceKey=rgbBS}"/>
        </ContentControl>
        <ContentControl Grid.Column="1" Grid.Row="0">
            <Border Name="borderGrid" BorderThickness="4" CornerRadius="20" BorderBrush="{StaticResource ResourceKey=lgbBY}" Background="{StaticResource ResourceKey=rgbBS}"/>
        </ContentControl>
        <ContentControl Grid.Column="2" Grid.Row="0">
            <Border Name="borderOutput" BorderThickness="4" CornerRadius="20" BorderBrush="{StaticResource ResourceKey=lgbBY}" Background="{StaticResource ResourceKey=rgbBS}"/>
        </ContentControl>
        <Button Name="btn1" Grid.Column="0" Grid.Row="1" Click="btn1_Click" Margin="10" HorizontalAlignment="Center" Content="Command 1" Background="{StaticResource ResourceKey=lgbBY}"/>
        <Button Name="btn2" Grid.Column="1" Grid.Row="1" Click="btn2_Click" Margin="10" HorizontalAlignment="Center" Content="Command 2" Background="{StaticResource ResourceKey=lgbBY}"/>
        <Button Name="btn3" Grid.Column="2" Grid.Row="1" Click="btn3_Click" Margin="10" HorizontalAlignment="Center" Content="Command 3" Background="{StaticResource ResourceKey=lgbBY}"/>
    </Grid>
</Window>
