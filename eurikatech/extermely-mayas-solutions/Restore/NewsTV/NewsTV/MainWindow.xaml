<Window x:Class="NewsTV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Offset="0" Color="Pink"/>
                <GradientStop Offset="1" Color="Yellow"/>
            </LinearGradientBrush>
        </Grid.Background>
        <ContentControl Name="contenter" Grid.ColumnSpan="4" Margin="5"/>
        <TextBlock Grid.Row="1" Margin="5" Text="Longitude"/>
        <TextBox Name="txLongitude" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="2" Margin="5" Text="Latitude"/>
        <TextBox Name="txLatitude" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="1" Grid.Column="2" Margin="5" Text="Keyword"/>
        <TextBox Name="txKeyword" Grid.Row="1" Grid.Column="3" Margin="5"/>

        <Button Name="btnRun" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="3" Margin="5" Content="Run" Click="btnRun_Click" />
    </Grid>
</Window>
