<Window x:Class="WarPlanning.WinMessage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="180" Width="350"
        WindowStyle="ToolWindow" MaxHeight="200" MaxWidth="400"
        Background="{StaticResource ResourceKey=background}"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Name="txMessage" Text="Message." TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <Image Grid.Column="1" Margin="5" Name="imgIcon"/>
        <Button Grid.Row="1" Grid.ColumnSpan="2" Name="btnAccept" Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=buttons}" Content="Accept" Click="btnAccept_Click" />
    </Grid>
</Window>
