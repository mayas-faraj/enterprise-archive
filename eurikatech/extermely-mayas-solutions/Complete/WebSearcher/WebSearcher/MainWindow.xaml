<Window x:Class="WebSearcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="420" Width="525">
    <Grid>
        <Grid Name="maingrd" Margin="5">
            <Grid.Background>
                <LinearGradientBrush>
                    <GradientStop Color="Red" Offset="0"/>
                    <GradientStop Color="Green" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Mayas Hack System" Margin="20" FontSize="40" TextAlignment="Center" FontFamily="Cooper">
                <TextBlock.Foreground>
                    <LinearGradientBrush>
                        <GradientStop Color="Black" Offset="0"/>
                        <GradientStop Color="Blue" Offset=".5"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="10" Height="20" TextWrapping="Wrap" Text="Search Word" />
            <TextBox Name="txMain" Grid.Row="1" Grid.Column="1" Margin="10" Height="25" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="10" Height="20" TextWrapping="Wrap" Text="Excell File" />
            <TextBox Name="txResultFile" Grid.Row="2" Grid.Column="1" Margin="10" Height="25" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="d:\result.csv" />
            <TextBlock Grid.Row="3" Grid.Column="0" Margin="10" Height="20" TextWrapping="Wrap" Text="File Depth" />
            <TextBox Name="txSearchDepth" Grid.Row="3" Grid.Column="1" Margin="10" Height="25" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="3" />
            <TextBlock Grid.Row="4" Grid.Column="0" Margin="10" Height="20" TextWrapping="Wrap" Text="Visited Sites" />
            <TextBox Name="txResult" Grid.Row="4" Grid.Column="1" Margin="10" Height="75" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <Button Name="btnPause" Grid.Row="5" Grid.Column="0" Content="Pause" Margin="10" Click="btnPause_Click" />
            <Button Name="btnMain" Grid.Row="5" Grid.Column="1" Content="Hack Emails" Margin="10" Click="btnMain_Click" />

        </Grid>
    </Grid>
</Window>
