<Window x:Class="ManiyatAssistance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="600" Width="600" Icon="/ManiyatAssistance;component/Golden%20Wallpaper%20%28177%29.ico">
    <Grid>
        <Grid.Resources>
            <LinearGradientBrush x:Key="texts">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="Yellow" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="Silver" Offset="1.5"/>
            </RadialGradientBrush>
        </Grid.Background>
        
        <Button Name="btnOpen" Grid.RowSpan="2" Margin="5" Content="Open" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact" Click="btnOpen_Click" />
        <Button Name="btnDir" Grid.RowSpan="2" Grid.Column="1" Margin="5" Content="Dir" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact" Click="btnDir_Click" />
        <RadioButton Name="rbEnglish" Grid.Column="3" Margin="5" Content="English" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16" IsChecked="True" />
        <RadioButton Name="rbArabic" Grid.Column="3" Grid.Row="1" Margin="5" Content="Arabic" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16"/>
        
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Name="btnPrev" Grid.Column="0" Margin="2" Content="&lt;" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact" IsEnabled="False" Click="btnPrev_Click" />
            <Button Name="btnNext" Grid.Column="1" Margin="2" Content="&gt;" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact" IsEnabled="False" Click="btnNext_Click" />
        </Grid>
        
        <CheckBox Name="rbHack" Grid.Column="2" Grid.Row="0" Margin="5" Content="Hack String" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16"/>
        <CheckBox Name="rbRemoveShifts" Grid.Column="4" Grid.Row="0" Margin="5" Content="No Shifts" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16"/>
        <CheckBox Name="rbRemoveAltCtrl" Grid.Column="4" Grid.Row="1" Margin="5" Content="NO Alt-CTRL" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16"/>
        <CheckBox Name="rbRemoveArrows" Grid.Column="5" Grid.Row="0" Margin="5" Content="No Arrows" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16"/>
        <CheckBox Name="rbRemoveMouses" Grid.Column="5" Grid.Row="1" Margin="5" Content="NO Mouses" Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16"/>

        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="5" BorderThickness="3" BorderBrush="{StaticResource ResourceKey=texts}">
            <TextBlock Name="txName"  Foreground="{StaticResource ResourceKey=texts}" FontFamily="Impact" FontSize="16" HorizontalAlignment="Center"/>
        </Border>

        <Button Name="btnDelete" Grid.Row="2" Grid.Column="3" Margin="5" Content="Delete" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact" IsEnabled="False" Click="btnDelete_Click" />
        <Button Name="btnRename" Grid.Row="2" Grid.Column="4" Margin="5" Content="Rename" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact" IsEnabled="False" Click="btnRename_Click" />
        <TextBox Name="txRename" Grid.Row="2" Grid.Column="5" Margin="5" Background="Gray" Foreground="{StaticResource ResourceKey=texts}" FontSize="20" FontFamily="Impact"/>
        
        <Border Grid.ColumnSpan="6" Grid.Row="3" Margin="5" BorderThickness="5" BorderBrush="{StaticResource ResourceKey=texts}">
            <WebBrowser Name="frameMain"/>
        </Border>
    </Grid>
</Window>
