<Window x:Class="ManiyatAssistance.winRequest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="winRequest" Height="300" Width="450">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush>
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="Silver" Offset="1.5"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <LinearGradientBrush x:Key="texts">
                <GradientStop Color="White" Offset="0"/>
                <GradientStop Color="Yellow" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Maniyat Assistance" FontSize="30" FontWeight="Bold" Foreground="{StaticResource ResourceKey=texts}" HorizontalAlignment="Center" Margin="5"/>

        <TextBlock Grid.Row="1" Foreground="{StaticResource ResourceKey=texts}" Text="Sender" Margin="5" VerticalAlignment="Center"/>
        <TextBox Name="txSender" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="2" Foreground="{StaticResource ResourceKey=texts}" Text="Subject" Margin="5" VerticalAlignment="Center"/>
        <TextBox Name="txSubject" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="3" Foreground="{StaticResource ResourceKey=texts}" Text="Body" Margin="5" VerticalAlignment="Center"/>
        <TextBox Name="txBody" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Grid.Row="4" Foreground="{StaticResource ResourceKey=texts}" Text="Response" Margin="5" VerticalAlignment="Center"/>
        <TextBlock Name="tbResponse" Grid.Row="4" Grid.Column="1" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center" Margin="5" VerticalAlignment="Center"/>

        <Button Name="btnRun" Grid.Row="5" Grid.ColumnSpan="2" Margin="5" Content="Run" Click="btnRun_Click" />
    </Grid>
</Window>
