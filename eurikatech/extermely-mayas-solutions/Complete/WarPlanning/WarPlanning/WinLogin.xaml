<Window x:Class="WarPlanning.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система планирования войны" Height="500" Width="400" WindowStyle="ToolWindow" MaxHeight="350" MaxWidth="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ResourceKey=background}"
        >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Система планирования войны" TextAlignment="Center" FontSize="22" FontWeight="ExtraBold" Margin="5" Foreground="{StaticResource ResourceKey=texts}"/>

        <TextBlock Grid.Row="1" Text="Имя" Margin="5" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Name="txName"/>

        <TextBlock Grid.Row="2" Text="Пароль" Margin="5" Foreground="{StaticResource ResourceKey=texts}"/>
        <PasswordBox Grid.Row="2" Grid.Column="1" Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Name="txPassword"/>

        <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Margin="5" Name="progressBar" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=progressBars}"/>

        <Grid Grid.Row="4" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="btnEnter" Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=buttons}" Content="Введите" Click="btnEnter_Click" />
            <Button Grid.Column="1" Name="btnConnect" Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=buttons}" Content="Подключение" Click="btnConnect_Click" />
            <Button Grid.Column="2" Name="btnExit" Margin="5" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=buttons}" Content="Выход" Click="btnExit_Click" />
        </Grid>

        <TextBlock Grid.ColumnSpan="2" Grid.Row="5" Background="{StaticResource ResourceKey=texts}" Text="Это приложение используется только для центра российского агентства, говорят корпорация, Волгоград, революции улица, 224." Margin="5" TextWrapping="Wrap"/>
    </Grid>
</Window>
