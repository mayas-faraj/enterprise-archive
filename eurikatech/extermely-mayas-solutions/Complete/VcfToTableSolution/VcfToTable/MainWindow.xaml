<Window x:Class="VcfToTable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="Brown" Offset="0"/>
                <GradientStop Color="Red" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid.Resources>
            <Thickness x:Key="margin">10</Thickness>
        </Grid.Resources>

        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Margin="{StaticResource ResourceKey=margin}" Text="Vcf To Table" FontFamily="Impact" FontSize="40"  TextAlignment="Center">
            <TextBlock.Foreground>
                <RadialGradientBrush>
                    <GradientStop Color="Yellow" Offset="0"/>
                    <GradientStop Color="Orange" Offset="1"/>
                </RadialGradientBrush>
            </TextBlock.Foreground>
            <TextBlock.Effect>
                <DropShadowEffect/>
            </TextBlock.Effect>
        </TextBlock>

        <TextBlock Grid.Column="0" Grid.Row="1" Margin="{StaticResource ResourceKey=margin}" Text="Source Directory" VerticalAlignment="Center" FontSize="15"/>
        <TextBox Grid.Column="1" Grid.Row="1" Margin="{StaticResource ResourceKey=margin}" Name="txSource" Background="LightPink" FontSize="15"/>
        <Button Grid.Column="2" Grid.Row="1" Margin="{StaticResource ResourceKey=margin}" Name="btnSource" Content="Browse..." Background="Pink" Click="btnSource_Click"/>

        <TextBlock Grid.Column="0" Grid.Row="2" Margin="{StaticResource ResourceKey=margin}" Text="Destination Directory" VerticalAlignment="Center" FontSize="15"/>
        <TextBox Grid.Column="1" Grid.Row="2" Margin="{StaticResource ResourceKey=margin}" Name="txDestination" Background="LightPink" FontSize="15"/>
        <Button Grid.Column="2" Grid.Row="2" Margin="{StaticResource ResourceKey=margin}" Name="btnDestination" Content="Browse..." Background="Pink" Click="btnDestination_Click"/>

        <TextBlock Grid.Column="0" Grid.Row="3" Margin="{StaticResource ResourceKey=margin}" Text="Report" VerticalAlignment="Center" FontSize="15"/>
        <TextBox Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Name="txReport" Background="LightPink" FontSize="15"/>

        <Button Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Name="btnStart" Margin="{StaticResource ResourceKey=margin}" Background="LightPink" Content="Start" Click="btnStart_Click"/>
        <Button Grid.Column="2" Grid.Row="4" Name="btnEnd" Margin="{StaticResource ResourceKey=margin}" Background="LightPink" Content="End" Click="btnEnd_Click"/>
    </Grid>
</Window>
