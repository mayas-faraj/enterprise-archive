<Window x:Class="WideControlApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="480" Width="640">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.Resources>
            <RadialGradientBrush x:Key="captions">
                <GradientStop Offset="0" Color="LightBlue"/>
                <GradientStop Offset="1" Color="Coral"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="textBoxes">
                <GradientStop Offset="0" Color="Pink"/>
                <GradientStop Offset="1" Color="Yellow"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="texts">
                <GradientStop Offset="0" Color="Blue"/>
                <GradientStop Offset="1" Color="Navy"/>
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="buttons">
                <GradientStop Offset="0" Color="Black"/>
                <GradientStop Offset="1" Color="Silver"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="textBlockes">
                <GradientStop Offset="0" Color="Orange"/>
                <GradientStop Offset="1" Color="Yellow"/>
            </LinearGradientBrush>
        </Grid.Resources>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Offset="0" Color="Silver"/>
                <GradientStop Offset="1" Color="Black"/>
            </LinearGradientBrush>
        </Grid.Background>
        
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="10" Text="نظام التحكم المحلي" Foreground="{StaticResource ResourceKey=captions}" FontSize="40" FontFamily="Times New Roman" TextAlignment="Center"/>

        <Button Grid.Row="1" Grid.Column="0" Margin="60,10,60,10" Name="btnManual" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBlockes}" Click="btnManual_Click">
            <StackPanel>
                <TextBlock Text="تحكم يدوي" TextAlignment="Center"/>
                <Image Stretch="Fill" Source="/WideControlApplication;component/Images/keys.gif" Height="120" Width="120" />
            </StackPanel>
            
            
        </Button>
        <Button Grid.Row="1" Grid.Column="1" Margin="60,10,60,10" Name="btnAutomatic" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=textBlockes}" Click="btnAutomatic_Click">
            <StackPanel>
                <TextBlock Text="تحكم عن بعد" TextAlignment="Center"/>
                <Image Stretch="Fill" Source="/WideControlApplication;component/Images/internet_connection.png" Height="120" Width="120" />
            </StackPanel>


        </Button>
        <Grid Grid.Row="2" Grid.Column="0" Margin="60,10,60,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Slider Grid.RowSpan="2" Grid.Column="3" Name="sliderVelocity" Orientation="Vertical" SmallChange="0.1" TickFrequency=".1"  TickPlacement="Both" Maximum="1" IsSnapToTickEnabled="True" Value="1" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="3" Foreground="{StaticResource ResourceKey=textBlockes}" Text="{Binding ElementName=sliderVelocity,Path=Value}" TextAlignment="Center" Margin="10" FontSize="14"/>

            <Button Grid.Row="0" Grid.Column="1" Name="btnUp" Margin="0" Background="{StaticResource ResourceKey=buttons}" Click="btnUp_Click">
                <Image Source="/WideControlApplication;component/Images/1uparrow.ico"/>
            </Button>
            <Button Grid.Row="1" Grid.Column="2" Name="btnRight" Margin="0" Background="{StaticResource ResourceKey=buttons}" Click="btnRight_Click">
                <Image Source="/WideControlApplication;component/Images/1rightarrow.ico" />
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Name="btnLeft" Margin="0" Background="{StaticResource ResourceKey=buttons}" Click="btnLeft_Click">
                <Image Source="/WideControlApplication;component/Images/1leftarrow.ico" />
            </Button>
            <Button Grid.Row="2" Grid.Column="1" Name="btnDown" Margin="0" Background="{StaticResource ResourceKey=buttons}" Click="btnDown_Click">
                <Image Source="/WideControlApplication;component/Images/1downarrow.ico" />
            </Button>
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1" Margin="60,10,60,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{StaticResource ResourceKey=textBlockes}" Text="X" TextAlignment="Center" Margin="10"/>
            <TextBox Name="txX"  Grid.Row="0" Grid.Column="0" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10" Text="" TextAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource ResourceKey=textBlockes}" Text="Y" TextAlignment="Center" Margin="10"/>
            <TextBox Name="txY"  Grid.Row="1" Grid.Column="0" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10" Text="" TextAlignment="Center"/>

            <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource ResourceKey=textBlockes}" Text="المنفذ" TextAlignment="Center" Margin="10"/>
            <TextBox Name="txRadius"  Grid.Row="2" Grid.Column="0" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10" Text="" TextAlignment="Center"/>

            <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{StaticResource ResourceKey=textBlockes}" Text="زمن الدورة" TextAlignment="Center" Margin="10"/>
            <TextBox Name="txTheta"  Grid.Row="3" Grid.Column="0" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Margin="10" Text="" TextAlignment="Center"/>
            
        </Grid>
    </Grid>
</Window>
