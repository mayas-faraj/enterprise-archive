<Application x:Class="WarPlanning.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="loginWindow.xaml">
    <Application.Resources>
        <ImageBrush x:Key="background">
            <ImageBrush.ImageSource>/EncryptionAssistance;component/bin/Debug/images/2.jpg</ImageBrush.ImageSource>
            <ImageBrush.Opacity>.5</ImageBrush.Opacity>
            <ImageBrush.Stretch>UniformToFill</ImageBrush.Stretch>
        </ImageBrush>
        <ImageBrush x:Key="buttons">
            <ImageBrush.ImageSource>/EncryptionAssistance;component/bin/Debug/images/4.jpg</ImageBrush.ImageSource>
            <ImageBrush.Stretch>None</ImageBrush.Stretch>
        </ImageBrush>
        <ImageBrush x:Key="textBoxes">
            <ImageBrush.ImageSource>/EncryptionAssistance;component/bin/Debug/images/1.jpg</ImageBrush.ImageSource>
            <ImageBrush.Opacity>.5</ImageBrush.Opacity>
            <ImageBrush.Stretch>UniformToFill</ImageBrush.Stretch>
        </ImageBrush>
        <ImageBrush x:Key="progressBars">
            <ImageBrush.ImageSource>/EncryptionAssistance;component/bin/Debug/images/3.jpg</ImageBrush.ImageSource>
            <ImageBrush.Opacity>.8</ImageBrush.Opacity>
            <ImageBrush.Stretch>UniformToFill</ImageBrush.Stretch>
        </ImageBrush>
        <RadialGradientBrush x:Key="texts">
            <GradientStop Color="Yellow" Offset="0"/>
            <GradientStop Color="White" Offset="1"/>
        </RadialGradientBrush>
    </Application.Resources>
</Application>