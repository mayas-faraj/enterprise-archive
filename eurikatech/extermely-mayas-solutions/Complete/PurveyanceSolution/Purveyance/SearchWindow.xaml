<Window x:Class="Purveyance.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:y="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
        Title="Search Window"  Height="600" Width="640" WindowState="Maximized"
        FlowDirection="RightToLeft" 
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="المعلومات الأجمالية" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Center">
                <TextBlock Name="lbPurveyance" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Image Name="imgPurveyance" Width="70" Height="70"/>
            </StackPanel>

            <TextBlock Name="lbMetarial" Grid.Row="2" Grid.Column="0" Margin="{StaticResource ResourceKey=margin}" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}"  Text="المادة" />
            <ComboBox Name="lsMaterials" Grid.Row="2" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" SelectionChanged="lsMaterials_SelectionChanged"/>

            <TextBlock Grid.Row="3" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="كلمة البحث"/>
            <TextBox Name="txSearch" Grid.Row="3" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>
            
            <TextBlock Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="الشهر"/>
            <Calendar Name="calendar" Grid.Row="2" Grid.Column="2" Grid.RowSpan="6"  DisplayMode="Year" Grid.ColumnSpan="2"  MouseUp="calendar_MouseUp" />
            
            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="عند الضغط على زر البحث سيتم عرض جميع سجلات الصادر والوارد, أما عند تحديد كلمة البحث فسوف يتم عرض السجلات التي تحوي تلك الكلمة فقط" TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="{StaticResource ResourceKey=margin}" HorizontalAlignment="Center">
                <Button Name="btnMath" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" HorizontalAlignment="Right" Click="btnMath_Click">
                    <Image Width="50" Source="images/lassists.png"/>
                </Button>
                <Button Name="btnCalculator" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" HorizontalAlignment="Left" Click="btnCalculator_Click">
                    <Image Width="50" Source="images/CMS-Indemnity-OD-B-calc.png"/>
                </Button>
            </StackPanel>
            
            <Border Grid.Row="7" Grid.ColumnSpan="3" Margin="{StaticResource ResourceKey=margin}" BorderBrush="{StaticResource ResourceKey=texts}" BorderThickness="{StaticResource ResourceKey=borderThickness}">
                <ScrollViewer>
                    <DataGrid Name="dgMain" Background="{StaticResource ResourceKey=textBoxes}" Foreground="{StaticResource ResourceKey=texts}" AlternatingRowBackground="LightPink" RowBackground="{StaticResource ResourceKey=textBoxes}" AlternationCount="0"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="8" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnBack" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="عودة" Click="btnBack_Click"/>
                <Button Grid.Column="1" Name="btnExit" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="خروج" Click="btnExit_Click"/>
            </Grid>   
        </Grid>
    </Border>
</Window>
