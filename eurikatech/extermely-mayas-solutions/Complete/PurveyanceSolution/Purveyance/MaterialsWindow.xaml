<Window x:Class="Purveyance.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaterialsWindow" Height="480" Width="640" Activated="Window_Activated_1"
        WindowState="Maximized"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="ادارة المواد" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>
            
            <ListBox Name="lsMaterials" Grid.Row="1" Grid.Column="1" Grid.RowSpan="7" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=textBoxes}" Foreground="{StaticResource ResourceKey=texts}" SelectionChanged="lsMaterials_SelectionChanged"/>
            
            <Button Name="btnAdd" Grid.Column="0" Grid.Row="1" Margin="{StaticResource ResourceKey=margin}" Content="أضافة المادة" Foreground="{StaticResource ResourceKey=buttonTexts}" Background="{StaticResource ResourceKey=buttons}" Click="btnAdd_Click"/>
            <Button Name="btnEdit" Grid.Column="0" Grid.Row="2" Margin="{StaticResource ResourceKey=margin}" Content="تعديل المادة" Foreground="{StaticResource ResourceKey=buttonTexts}" Background="{StaticResource ResourceKey=buttons}" Click="btnEdit_Click" IsEnabled="False"/>
            <Button Name="btnDelete" Grid.Column="0" Grid.Row="3" Margin="{StaticResource ResourceKey=margin}" Content="حذف مادة" Foreground="{StaticResource ResourceKey=buttonTexts}" Background="{StaticResource ResourceKey=buttons}" Click="btnDelete_Click" IsEnabled="False"/>
            <Button Name="btnBack" Grid.Column="0" Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Content="عودة" Foreground="{StaticResource ResourceKey=buttonTexts}" Background="{StaticResource ResourceKey=buttons}" Click="btnBack_Click"/>
            <Button Name="btnExit" Grid.Column="0" Grid.Row="6" Margin="{StaticResource ResourceKey=margin}" Content="خروج" Foreground="{StaticResource ResourceKey=buttonTexts}" Background="{StaticResource ResourceKey=buttons}" Click="btnExit_Click"/>

            <TextBlock Grid.Row="5" Text="يتم الآن عرض قائمة للمواد التي تم تخزينها مسبقاً, إذا كانت القائمة فارغة فهذا لأنه لم يتم أدخال أي مادة, أنقر أضافة مادة لأضافة مادة جديدة ومن ثم يمكن تعجيل المعلومات الخاصة بلك المادة عن طريق أختيارها من القائمة ثم أختيار تعديل" TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>

        </Grid>
    </Border>
</Window>
