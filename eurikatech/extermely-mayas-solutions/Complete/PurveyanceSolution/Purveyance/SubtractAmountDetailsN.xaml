<Window x:Class="Purveyance.SubtractAmountDetailsN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubtractAmountDetailsN" Height="480" Width="640"
        FlowDirection="RightToLeft"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="تخريج دفعات" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                <TextBlock Name="lbPurveyance" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Image Name="imgPurveyance" Width="70" Height="70"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="سعر المبيع"/>
            <TextBox Name="txSellPrice" Grid.Row="2" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="3" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="تكاليف النقل"/>
            <TextBox Name="txTransport" Grid.Row="3" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="تكاليف أخرى"/>
            <TextBox Name="txOther" Grid.Row="4" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="5" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="تاريخ"/>
            <DatePicker Name="dpDate" Grid.Row="5" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>
            
            <TextBlock Grid.Row="6" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="ملاحظات"/>
            <TextBox Name="txDescription" Grid.Row="6" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="بالنسبة للمعطيات الواردة أعلاه, فأنها تعبر عن قيم مشتركة لجميع المعطيات الموجودة في الأسفل, أي أنه من أجل كل بند من الأسفل يملك سعر وتكاليف وملاحظات نفس القيم الموجودة في الأعلى." TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>

            <Border Grid.Row="8" Grid.ColumnSpan="2" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Margin="{StaticResource ResourceKey=margin}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Name="grid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="الزبون" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="الكمية" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="سعر المبيع" HorizontalAlignment="Center"/>    
                        
                        <StackPanel Name="stackClients" Grid.Row="1" Grid.Column="0"/>
                        <StackPanel Name="stackAmounts" Grid.Row="1" Grid.Column="1"/>
                        <StackPanel Name="stackSellPrice" Grid.Row="1" Grid.Column="2"/>
                    </Grid>
                </ScrollViewer>
            </Border>
            
            <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnSave" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="حفظ" Click="btnSave_Click"/>
                <Button Grid.Column="1" Name="btnBack" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="عودة" Click="btnBack_Click"/>
                <Button Grid.Column="2" Name="btnExit" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="خروج" Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
