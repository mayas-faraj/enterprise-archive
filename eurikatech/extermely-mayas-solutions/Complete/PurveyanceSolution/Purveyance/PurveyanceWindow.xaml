<Window x:Class="Purveyance.PurveyanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purveyance Window" 
        Height="480" Width="640"
        FlowDirection="RightToLeft" Activated="Window_Activated_1"
        WindowState="Maximized"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="ادارة الدفعات" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Name="lbPurveyance" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Image Name="imgPurveyance" Width="70" Height="70"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Grid.Row="1" Text="الدفعات الواردة" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold"/>
                <Image Width="70" Height="70" Source="images/AVX_ICONS INCOMING FOLDER.png" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center">
                <Button Name="btnAdd" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="اضافة دفعة" Click="btnAdd_Click">
                    <Image Width="50" Source="images/edit_add.png"/>
                </Button>
                <Button Name="btnEdit" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="تعديل دفعة" IsEnabled="False" Click="btnEdit_Click">
                    <Image Width="50" Source="images/config868.png"/>
                </Button>
                <Button Name="btnDelete" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="ازالة دفعة" IsEnabled="False" Click="btnDelete_Click">
                    <Image Width="50" Source="images/Comic_Tiger_2 trash.png"/>
                </Button>

                <Button Name="btnSearch" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="الدفعات الأجمالية" Click="btnSearch_Click">
                    <Image Width="50" Source="images/d3A big pack search.png"/>
                </Button>

                <Button Name="btnCalculator" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="ازالة دفعة" Click="btnCalculator_Click">
                    <Image Width="50" Source="images/CMS-Indemnity-OD-B-calc.png"/>
                </Button>

                <CheckBox Name="chkActiveAmount" Content="دفعات فعالة فقط" FontSize="{StaticResource ResourceKey=fontSize}" FontWeight="Bold" Foreground="{StaticResource ResourceKey=texts}" VerticalAlignment="Center" Margin="{StaticResource ResourceKey=margin}" Click="chkActiveAmount_Click"/>
            </StackPanel>
            
            <ListBox Name="lsAmounts" Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" HorizontalAlignment="Center" MinWidth="200" SelectionChanged="lsAmounts_SelectionChanged" MouseDoubleClick="lsAmounts_MouseDoubleClick"/>

            <Button Grid.Row="5" Name="btnManage" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="ادارة توزيع الدفعة" HorizontalAlignment="Center" MinWidth="200" Click="btnManage_Click"/>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Name="btnBack" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="عودة" Click="btnBack_Click"/>
                <Button Grid.Column="1" Name="btnExit" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="خروج" Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
