<Application x:Class="Purveyance.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="backgrounds">
            <GradientStop Color="Green" Offset="0"/>
            <GradientStop Color="Yellow" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="borders">
            <GradientStop Color="Red" Offset="0"/>
            <GradientStop Color="Orange" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="headerTexts">
            <GradientStop Color="Red" Offset="0"/>
            <GradientStop Color="Orange" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="textBoxes">
            <GradientStop Color="LightBlue" Offset="0"/>
            <GradientStop Color="Cyan" Offset="1"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="texts">
            <GradientStop Color="Black" Offset="0"/>
            <GradientStop Color="DarkGreen" Offset=".5"/>
            <GradientStop Color="Black" Offset="1"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="buttons">
            <GradientStop Color="Navy" Offset="0"/>
            <GradientStop Color="DarkBlue" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="buttonTexts">
            <GradientStop Color="LightBlue"/>
            <GradientStop Color="LightCyan"/>
        </LinearGradientBrush>
        <sys:Double x:Key="headerFontSize">26</sys:Double>
        <sys:Double x:Key="fontSize">16</sys:Double>
        <Thickness x:Key="borderThickness">5</Thickness>
        <Thickness x:Key="margin">5</Thickness>
        <CornerRadius x:Key="corners">
            0,15,0,15
        </CornerRadius>
    </Application.Resources>
</Application>
