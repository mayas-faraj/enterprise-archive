<Window x:Class="Purveyance.AddAmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolkit="http://schemas.microsoft.com/wpf/2008/toolkit"
        Title="Add Amount" Height="480" Width="640"
        FlowDirection="RightToLeft" Closing="Window_Closing_1"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="أضافة دفعة" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                <TextBlock Name="lbPurveyance" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Image Name="imgPurveyance" Width="70" Height="70"/>
            </StackPanel>
 
            <TextBlock Grid.Row="3" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="المزود"/>
            <TextBox Name="txVendor" Grid.Row="3" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="سعر الشراء"/>
            <TextBox Name="txBuyPrice" Grid.Row="4" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="6" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="الكمية"/>
            <TextBox Name="txAmount" Grid.Row="6" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="7" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="تكاليف النقل"/>
            <TextBox Name="txTransport" Grid.Row="7" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>
            
            <TextBlock Grid.Row="8" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="تكاليف أخرى"/>
            <TextBox Name="txOther" Grid.Row="8" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="9" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="ملاحظات"/>
            <TextBox Name="txDescription" Grid.Row="9" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="10" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=fontSize}" Text="تاريخ"/>
            <DatePicker Name="dpDate" Grid.Row="10" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>


            <TextBlock Grid.Row="11" Grid.ColumnSpan="3" Text="يجب ملئ جميع مربعات النص أعلاه بالمعلومات, بالنسبة للمزود (مزود المادة التموينية) فيتم أختياره من القائمة جانت عبارة -مزود- أما أن كانت القائمة فارغة أو لا يوجد المزود المطلوب فيجب أدخال المزود في مربع النص -مزود جديد- وبالتالي يتم تخزينه ويتم في المرة المقبلة أختياره من القائمة" TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>

            <Grid Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnSave" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="حفظ" Click="btnSave_Click"/>
                <Button Grid.Column="1" Name="btnBack" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="عودة" Click="btnBack_Click"/>
                <Button Grid.Column="2" Name="btnExit" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="خروج" Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
