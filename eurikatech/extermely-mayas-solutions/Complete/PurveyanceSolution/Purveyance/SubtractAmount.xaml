<Window x:Class="Purveyance.SubtractAmount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtract Amount" Height="480" Width="640"
        FlowDirection="RightToLeft" Activated="Window_Activated_1"
        WindowState="Maximized"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="توزيع الدفعات" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center">
                <TextBlock Name="lbPurveyance" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Image Name="imgPurveyance" Width="70" Height="70"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Grid.Row="1" Text="الدفعات الصادرة" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold"/>
                <Image Width="70" Height="70" Source="images/AVX_ICONS OUTGOING FOLDER.png" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center">
                <Button Name="btnRemove" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="اضافة دفعة" Click="btnRemove_Click">
                    <Image Width="50" Source="images/edit_remove.png"/>
                </Button>
                
                <Border Margin="{StaticResource ResourceKey=margin}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="3">
                    <StackPanel Orientation="Horizontal">
                        <Button Name="btnRemoveN" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="اضافة دفعة" Click="btnRemoveN_Click">
                            <Image Width="50" Source="images/edit_remove.png"/>
                        </Button>
                        
                        <TextBox Name="txN" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" MinWidth="50" VerticalAlignment="Center"/>
                    </StackPanel> 
                </Border>

                <Button Name="btnEdit" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="تعديل الدفعة" IsEnabled="False" Click="btnEdit_Click">
                    <Image Width="50" Source="images/config868.png"/>
                </Button>

                <Button Name="btnDelete" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="ازالة الدفعة" IsEnabled="False" Click="btnDelete_Click">
                    <Image Width="50" Source="images/Comic_Tiger_2 trash.png"/>
                </Button>
  
                <Button Name="btnCalculator" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" ToolTip="ازالة دفعة" Click="btnCalculator_Click">
                    <Image Width="50" Source="images/CMS-Indemnity-OD-B-calc.png"/>
                </Button>
            </StackPanel>

            <ListBox Name="lsOutcome" Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=textBoxes}" HorizontalAlignment="Center" MinWidth="250" SelectionChanged="lsOutcome_SelectionChanged" MouseDoubleClick="lsOutcome_MouseDoubleClick"/>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="btnBack" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="عودة" Click="btnBack_Click"/>
                <Button Grid.Column="1" Name="btnExit" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttons}" Background="{StaticResource ResourceKey=buttonTexts}" Content="خروج" Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
