<Window x:Class="Purveyance.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Window" Height="300" Width="350"
        FlowDirection="RightToLeft"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <StackPanel>
            <TextBlock Grid.ColumnSpan="2" Text="مدير المواد التموينية 1.0" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=buttonTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="تم تصميم هذا النظام لأدارة المحتويات التموينبة بتاريخ 17/3/2013 في دمشق..." TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>

            <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="مطور النظام: م. مياس فرج" TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>
            
            <Border BorderThickness="4" BorderBrush="{StaticResource ResourceKey=borders}" HorizontalAlignment="Center"  Width="75">
                <Image Source="images/logoMob2.jpg"/>
            </Border>
            
            <Button Margin="{StaticResource ResourceKey=margin}" Content="أخفاء" Name="btnHide" HorizontalAlignment="Center" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Click="btnHide_Click"/>
            
        </StackPanel>
    </Border>
</Window>
