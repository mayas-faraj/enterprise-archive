<Window x:Class="Purveyance.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaterialWindow" Height="480" Width="640"
        FlowDirection="RightToLeft" WindowState="Maximized"
        >
    <Border CornerRadius="{StaticResource ResourceKey=corners}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=borderThickness}" Background="{StaticResource ResourceKey=backgrounds}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="ادارة مادة" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=headerFontSize}" Foreground="{StaticResource ResourceKey=headerTexts}" FontWeight="Bold">
                <TextBlock.Effect>
                    <DropShadowEffect />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Name="lbMaterialName" Grid.Row="1" Grid.ColumnSpan="2" Margin="{StaticResource ResourceKey=margin}" TextAlignment="Center" FontSize="{StaticResource ResourceKey=fontSize}" Foreground="{StaticResource ResourceKey=texts}" FontWeight="Bold"/>
            
            <TextBlock Grid.Row="2" Text="الأسم" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}"/>
            <TextBox Name="txName" Grid.Row="2" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="3" Text="المزود" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}"/>
            <TextBox Name="txVendor" Grid.Row="3" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="4" Text="الكمية" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}"/>
            <TextBox Name="txAmount" Grid.Row="4" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="5" Text="سعر الشراء" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}"/>
            <TextBox Name="txBuyPrice" Grid.Row="5" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="6" Text="سعر المبيع" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}"/>
            <TextBox Name="txSellPrice" Grid.Row="6" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}"/>

            <TextBlock Grid.Row="7" Text="تحديد صورة" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}"/>
            <Button Name="btnBrowse" Grid.Row="7" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=buttonTexts}" Background="{StaticResource ResourceKey=buttons}" Content="مسار الصورة" Click="btnBrowse_Click"/>

            <Border Grid.Row="1" Grid.Column="2" Grid.RowSpan="7" Background="Gray" BorderBrush="Black" BorderThickness="2" Margin="{StaticResource ResourceKey=margin}">
                <Image Name="imgLogo" Width="150"/>
            </Border>

            <TextBlock Grid.Row="8" Grid.ColumnSpan="3" Text="يجب تزويد البرنامج بجميع المعلومات السابقة بالأضافة لتحديد صورة كرمز للمادة, يتم تحديد الرمز عن طريق الضغط على زر مسار الصورة ثم تحديد ملف الصورة المناسبة وبعد الأنتهاء من الأدخال, يجب الضغط على زر الحفظ بالتالي سوف يتم حفظ معلومات المادة التموينية, لكن للعلم أن قيم المزود والكمية وسعر الشراء والمبيع هي فقط قيم أفتراضية ويتم تحديدها في كل عملية أضافة كمية لكن للسهولة يمكنك أدخال القيم الأفتراضية من هذه الصفحة." TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" TextAlignment="Center"/>


            <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Name="btnSave" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="حفظ" Click="btnSave_Click"/>
                <Button Grid.Column="1" Name="btnBack" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="عودة" Click="btnBack_Click"/>
                <Button Grid.Column="2" Name="btnExit" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonTexts}" Content="خروج" Click="btnExit_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
