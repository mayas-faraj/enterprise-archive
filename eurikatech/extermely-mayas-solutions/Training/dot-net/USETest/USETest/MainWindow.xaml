<Window x:Class="USETest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="300">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="Green" Offset="0"/>
                <GradientStop Color="yellow" Offset="1"/>
            </LinearGradientBrush>

        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Margin="5" Grid.Row="0" Grid.ColumnSpan="2" FontSize="22" TextAlignment="Center" FontWeight="Bold" Text="Mayas Control System">
            <TextBlock.Foreground>
                <LinearGradientBrush>
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="Red" Offset=".5"/>
                    <GradientStop Color="Black"  Offset="1"/>
            </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>

        <TextBlock Margin="5" Grid.Column="0" Grid.Row="1" Text="Port Name" Height="30"/>
        <ComboBox Name="cmbPorts" Margin="5" Grid.Column="1" Grid.Row="1" Height="30"/>

        <TextBlock Margin="5" Grid.Column="0" Grid.Row="2" Text="Bit Rate" Height="30"/>
        <TextBox Name="txbBitRate" Margin="5" Grid.Column="1" Grid.Row="2" Text="300" Height="30"/>

        <TextBlock Margin="5" Grid.Column="0" Grid.Row="3" Text="Data" Height="30"/>
        <TextBox Name="txInformation" Margin="5" Grid.Column="1" Grid.Row="3" Height="30"/>

        <Button Margin="5" Name="btnRun" Grid.ColumnSpan="2" Grid.Row="4" Content="Run" Click="btnRun_Click" />
    </Grid>
</Window>
