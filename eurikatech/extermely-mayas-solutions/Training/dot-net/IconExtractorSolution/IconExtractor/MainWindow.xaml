<Window x:Class="IconExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="350" Width="525">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <Button Name="btn1" Margin="5" Content="Button 1" Click="btn1_Click"/>
            <Button Name="btn2" Margin="5" Content="Button 2" Click="btn2_Click"/>
            <Button Name="btn3" Margin="5" Content="Button 3" Click="btn3_Click"/>
            <Button Name="btn4" Margin="5" Content="Button 4" Click="btn4_Click"/>
            <Button Name="btn5" Margin="5" Content="Button 5" Click="btn5_Click"/>
            <Button Name="btn6" Margin="5" Content="Button 6" Click="btn6_Click"/>
            <Button Name="btn7" Margin="5" Content="Button 7" Click="btn7_Click"/>
            <TextBox Name="txt" Margin="5" VerticalAlignment="Stretch" Background="Gray" HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</Window>
