<Window x:Class="WebBrawser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maniyat Internet Browser" Height="350" Width="525"
        >
    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="Navy" Offset="0"/>
                <GradientStop Color="DarkCyan" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" Grid.Row="0" Margin="3" Name="txURI" Background="Lime" Foreground="DarkGreen" Text="http://maps.google.com/maps?q=damascus"/>
        <Button Grid.Column="1" Grid.Row="0" Margin="3" Name="btnRun" Content="Go" Background="lime" Foreground="DarkGreen" Click="btnRun_Click" IsDefault="False" />
        <ContentControl Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Name="content" Margin="3"/>
    </Grid>
</Window>
