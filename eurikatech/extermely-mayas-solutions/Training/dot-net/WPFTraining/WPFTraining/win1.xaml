<Window xml:lang="fr-fr"  AllowsTransparency="False" WindowStyle="ThreeDBorderWindow" x:Class="WPFTraining.win1" xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero"  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mayas" Width="600" Height="800">
    <Window.Resources>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1" x:Key="lgbYG">
            <GradientStop Color="Yellow" Offset="0.3"/>
            <GradientStop Color="Green" Offset="1.2"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="lgbSB">
            <GradientStop Color="Silver" Offset="0"/>
            <GradientStop Color="DarkBlue" Offset="1"/>
        </LinearGradientBrush>
        <GeometryGroup FillRule="Nonzero" x:Key="geometry">
            <RectangleGeometry Rect="5,20,150,40" RadiusX="10" RadiusY="5"/>
            <EllipseGeometry RadiusX="60" RadiusY="35" Center="80,40"/>
        </GeometryGroup>
    </Window.Resources>
    <Window.Background>
        <LinearGradientBrush >
            <GradientStop Color="DarkBlue" Offset="1"/>
            <GradientStop Color="LightBlue" Offset="0"/>
        </LinearGradientBrush>
    </Window.Background>
    <ContentControl Background="LightGreen" MouseDown="ContentControl_MouseDown">
        <Border Background="Pink" CornerRadius="30" Margin="30">
            <StackPanel Name="panel">
                <DataGrid Name="dGrid" Margin="15,0,15,5"/>
                <Button Name="btnRun" Margin="15,0,15,10" Content="Run" Click="btnRun_Click" x:Uid="cmdRun" />
                <Slider Name="slider" Margin="15,0,15,10" Minimum="-10" Maximum="10"/>
                <TextBox Name="txSlider" Margin="15,0,60,10" Text="-10"/>
                <Button Name="btnCalture" Margin="15,0,15,15" Content="Calture" Click="btnCalture_Click" x:Uid="cmdCulture" />
                <Canvas Name="mainCanvas" Margin="10" Background="LightBlue" Height="500" MouseDown="Canvas_MouseDown" />
            </StackPanel>
        </Border>
    </ContentControl>
</Window>