<Window x:Class="WPFTraining.win3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="win3" Height="400" Width="500">
    <Canvas Name="main">
        
        <Image Name="img1" Canvas.Top="0" Canvas.Left="0" PreviewMouseUp="img1_PreviewMouseUp" PreviewMouseDown="img1_PreviewMouseDown" PreviewMouseMove="img1_PreviewMouseMove" />
        <Image Name="img2" Canvas.Top="250" Canvas.Left="350" Stretch="Fill"/>
        <TextBlock Name="lbColor" Canvas.Top="250" Canvas.Left="400" TextWrapping="Wrap" Width="50" Height="600" Background="Black"/>
    </Canvas>
</Window>
