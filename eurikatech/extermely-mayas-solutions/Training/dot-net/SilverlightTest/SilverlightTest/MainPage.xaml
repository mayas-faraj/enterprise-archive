<UserControl x:Class="SilverlightTest.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="400">

    <Grid x:Name="LayoutRoot" Background="Silver">
        <Grid.Resources>
            <LinearGradientBrush x:Key="lgbYB">
                <GradientStop Color="Yellow" Offset="0"/>
                <GradientStop Color="Blue" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="lgbGR">
                <GradientStop Color="Green" Offset="0"/>
                <GradientStop Color="Red" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" TextAlignment="Center" FontSize="40" FontFamily="Times New Roman" Text="Mayas Sliverlight" Margin="10" Foreground="{StaticResource lgbGR}"/>
        
        <TextBlock Grid.Row="1" Margin="10" Foreground="{StaticResource lgbYB}" Text="Name"/>
        <TextBox Grid.Row="1" Grid.Column="1" Foreground="{StaticResource lgbYB}" Background="Lime" Margin="10"/>

        <TextBlock Grid.Row="2" Margin="10" Foreground="{StaticResource lgbYB}" Text="Password"/>
        <TextBox Grid.Row="2" Grid.Column="1" Foreground="{StaticResource lgbYB}" Background="Lime" Margin="10"/>

        <TextBlock Grid.Row="3" Margin="10" Foreground="{StaticResource lgbYB}" Text="Server"/>
        <TextBox Grid.Row="3" Grid.Column="1" Foreground="{StaticResource lgbYB}" Background="Lime" Margin="10"/>
        
        <Button Grid.ColumnSpan="2" Grid.Row="4" Foreground="{StaticResource lgbYB}" Background="lime" Margin="10" Content="Command"/>
    </Grid>
</UserControl>
