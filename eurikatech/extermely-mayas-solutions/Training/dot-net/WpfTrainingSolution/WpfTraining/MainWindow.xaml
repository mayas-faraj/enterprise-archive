<Window x:Class="WpfTraining.MainWindow" x:Name="mas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Background="LightSkyBlue" MouseDown="clicked"
        Width="300" Height="420" Focusable="True"
        >
    <Grid MouseDown="clicked" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <Label Focusable="True" Grid.Row="0" PreviewMouseDown="clicked" Background="Blue" Width="150" HorizontalContentAlignment="Center" Margin="5">
            <StackPanel Focusable="True" PreviewMouseDown="clicked">
                <TextBlock Text="Label and Image" PreviewMouseDown="clicked" HorizontalAlignment="Center"/>
                <Image Focusable="True" Width="130" Height="130" Source="Images/Penguins.jpg" Stretch="Fill" PreviewMouseDown="clicked"/>
                <TextBox Text="footer label" PreviewMouseDown="clicked" HorizontalAlignment="Center"
                 KeyDown="keys" KeyUp="keys" PreviewKeyDown="keys" PreviewKeyUp="keys"
                         />
            </StackPanel>
        </Label>

        <ListBox Grid.Row="1" PreviewMouseDown="clicked" Margin="5" Name="lbResult"/>
        
        <CheckBox Name="chkHandle" Content="Handle on first event" Grid.Row="2" Margin="5" IsChecked="False"/>
        
        <Button Name="btnClear" Grid.Row="3" Content="Clear List" HorizontalAlignment="Right" Margin="5" Click="btnClear_Click"/>
        </Grid>
</Window>
