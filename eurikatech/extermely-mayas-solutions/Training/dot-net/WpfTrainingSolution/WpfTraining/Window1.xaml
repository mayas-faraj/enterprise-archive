<Window x:Class="WpfTraining.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window1" Height="300" Width="300">
    <WrapPanel Name="wrapPanel" Button.PreviewMouseDown="buttons" Orientation="Horizontal" Width="90">
        <TextBox Name="txt" FontFamily=".\#algerian" Text="mezo"  Width="90" Height="30" Background="LightBlue"/>
        <Button Name="btn1" Content="_1" Width="30" Height="30" ToolTip="One"/>
        <Button Name="btn2" Content="_2" Width="30" Height="30">
            <Button.ToolTip>
                <ToolTip HasDropShadow="True" Placement="MousePoint" Opacity=".6">
                    <Border BorderThickness="3" CornerRadius="3" BorderBrush="Navy">
                        <TextBlock Text="Mayas Faraj" FontFamily="Impact" FontSize="15" Background="Lime" Foreground="Blue" Opacity="1"/>
                    </Border>
                </ToolTip>
            </Button.ToolTip>
        </Button>
        <Button Name="btn3" Content="_3" Width="30" Height="30"/>
        <Button Name="btn4" Content="_4" Width="30" Height="30"/>
        <Button Name="btn5" Content="_5" Width="30" Height="30"/>
        <Button Name="btn6" Content="_6" Width="30" Height="30"/>
        <Button Name="btn7" Content="_7" Width="30" Height="30"/>
        <Button Name="btn8" Content="_8" Width="30" Height="30"/>
        <Button Name="btn9" Content="_9" Width="30" Height="30"/>
        <Button Name="btn0" Content="_0" Width="60" Height="30"/>
        <Button Name="btnstar" Content="c_lear" Width="30" Height="30"/>
        <Label Background="Red" Content="M_ayas" Target="{Binding ElementName=txt}" Width="100" Height="100" AllowDrop="True" DragEnter="Label_DragEnter_1" Drop="Label_Drop_1"/>
    </WrapPanel>
</Window>
