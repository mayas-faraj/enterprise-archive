<Window x:Class="BingMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:microsoft="clr-namespace:Microsoft.Maps.MapControl.WPF;assembly=Microsoft.Maps.MapControl.WPF"
        Title="MainWindow" Height="350" Width="525">
    <Window.Background>
        <LinearGradientBrush>
            <GradientStop Color="Blue" Offset="0"/>
            <GradientStop Color="Yellow" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <LinearGradientBrush x:Key="textBoxes">
            <GradientStop Offset="0" Color="LightBlue"/>
            <GradientStop Offset="1" Color="Pink"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="texts">
            <GradientStop Offset="0" Color="Gold"/>
            <GradientStop Offset="1" Color="DarkOrange"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="textBoxesText">
            <GradientStop Offset="0" Color="Navy"/>
            <GradientStop Offset="1" Color="DarkBlue"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="shadow"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" TextAlignment="Center" Text="GMap.NET Control Test unit" FontSize="18" FontWeight="Bold" Foreground="{StaticResource ResourceKey=texts}" Effect="{StaticResource ResourceKey=shadow}" Margin="4"/>

        <microsoft:Map Name="map" CredentialsProvider="AuErvBGdsDeD8sWFdUZV7HfdboghgTj5SDEsTc621Lxt4Vi5If2J9G3XLCkKoq_y" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="4"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="4" Text="Latitude" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Name="txLaditude" Grid.Row="2" Grid.Column="1" Margin="4" Foreground="{StaticResource ResourceKey=textBoxesText}" Text="0" Background="{StaticResource ResourceKey=textBoxes}"/>

        <TextBlock Grid.Row="2" Grid.Column="2" Margin="4" Text="Longitude" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Name="txLongitude" Grid.Row="2" Grid.Column="3" Margin="4" Foreground="{StaticResource ResourceKey=textBoxesText}" Text="0" Background="{StaticResource ResourceKey=textBoxes}"/>

        <Button Name="btnGoto" Grid.Row="2" Grid.Column="4" Margin="4" Content="Goto Point" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnGoto_Click"/>

        <TextBlock Grid.Row="3" Grid.Column="2" Margin="4" Foreground="{StaticResource ResourceKey=texts}" Text="Image Path"/>
        <TextBox Name="txImage" Grid.Row="3" Grid.Column="3" Margin="4" Text="0" Foreground="{StaticResource ResourceKey=textBoxesText}" Background="{StaticResource ResourceKey=textBoxes}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="4" Foreground="{StaticResource ResourceKey=texts}" Text="Altitude"/>
        <TextBox Name="txAltitude" Grid.Row="3" Grid.Column="1" Margin="4" Text="0" Foreground="{StaticResource ResourceKey=textBoxesText}" Background="{StaticResource ResourceKey=textBoxes}"/>

        <Button Name="btnApply" Grid.Row="3" Grid.Column="4" Margin="4" Content="Image" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnImage_Click"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="4" Text="Zoom" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Name="txZoom" Grid.Row="4" Grid.Column="1" Margin="4" Text="0" Foreground="{StaticResource ResourceKey=textBoxesText}" Background="{StaticResource ResourceKey=textBoxes}"/>

        <TextBlock Grid.Row="4" Grid.Column="2" Margin="4" Text="Time" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Name="txZoomTime" Grid.Row="4" Grid.Column="3" Margin="4" Text="0" Foreground="{StaticResource ResourceKey=textBoxesText}" Background="{StaticResource ResourceKey=textBoxes}"/>

        <Button Name="btnZoom" Grid.Row="4" Grid.Column="4" Margin="4" Content="Zoom" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnZoom_Click"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="4" Text="Heading" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Name="txHeading" Grid.Row="5" Grid.Column="1" Margin="4" Text="0" Foreground="{StaticResource ResourceKey=textBoxesText}" Background="{StaticResource ResourceKey=textBoxes}"/>
        
        <TextBlock Grid.Row="5" Grid.Column="2" Margin="4" Text="Time" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Name="txHeadingTime" Grid.Row="5" Grid.Column="3" Margin="4" Text="0" Foreground="{StaticResource ResourceKey=textBoxesText}" Background="{StaticResource ResourceKey=textBoxes}"/>

        <Button Name="btnHeading" Grid.Row="5" Grid.Column="4" Margin="4" Content="Heading" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnHeading_Click"/>


        <Button Name="btnAddRoute" Grid.Row="7" Grid.Column="0" Margin="4" Content="Add Route" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnAddRoute_Click"/>
        <Button Name="btnEndRoute" Grid.Row="7" Grid.Column="1" Margin="4" Content="End Route" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnEndRoute_Click"/>
        <Button Name="btnAddPoly" Grid.Row="7" Grid.Column="2" Margin="4" Content="Add Polygon" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnAddPoly_Click"/>
        <Button Name="btnEndPoly" Grid.Row="7" Grid.Column="3" Margin="4" Content="End Polygon" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnEndPoly_Click"/>
        <Button Name="btnClear" Grid.Row="7" Grid.Column="4" Margin="4" Content="Clear" Foreground="{StaticResource ResourceKey=texts}" Background="{StaticResource ResourceKey=textBoxes}" Padding="4" Click="btnClear_Click"/>


    </Grid>
</Window>
