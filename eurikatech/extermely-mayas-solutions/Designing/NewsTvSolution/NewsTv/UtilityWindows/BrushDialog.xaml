<Window x:Class="UtilityWindows.BrushDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolkit="http://schemas.microsoft.com/winfx/2006/xaml/presentation/toolkit/extended"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent" Opacity=".95"
        Title="Choose Gradient Colors" MinHeight="200" MinWidth="400" Height="200" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        MouseDown="Window_MouseDown" MouseMove="Window_MouseMove" MouseUp="Window_MouseUp">
    <Window.Resources>
        <ResourceDictionary Source="windowDictionary.xaml"/>
    </Window.Resources>

    <Border Name="AboutGrid" Background="{StaticResource ResourceKey=backgrounds}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=bordersWidth}" Opacity=".98" CornerRadius="{StaticResource ResourceKey=loginCornerRadius}">
        <Grid Margin="{StaticResource ResourceKey=margin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="txType" Grid.Row="0" Grid.Column="0" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" Text="Type" VerticalAlignment="Center"/>
            <ComboBox Name="cmType" Grid.Row="0" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" VerticalAlignment="Center" SelectionChanged="cmType_SelectionChanged">
                <ComboBox.Items>
                    <ComboBoxItem Content="Linear Gradient"/>
                    <ComboBoxItem Content="Radial Gradient"/>
                </ComboBox.Items>
                <ComboBox.SelectedIndex>0</ComboBox.SelectedIndex>
            </ComboBox>

            <TextBlock Name="txColor1" Grid.Row="1" Grid.Column="0" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" Text="Color 1" VerticalAlignment="Center"/>
            <toolkit:ColorPicker Name="cp1" Grid.Row="1" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" DisplayColorAndName="True" VerticalAlignment="Center" SelectedColorChanged="cp1_SelectedColorChanged" MouseMove="cp_MouseMove" MouseDown="cp_MouseUpDown" />

            <TextBlock Name="txColor2" Grid.Row="2" Grid.Column="0" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" Text="Color 2" VerticalAlignment="Center"/>
            <toolkit:ColorPicker Name="cp2" Grid.Row="2" Grid.Column="1" Margin="{StaticResource ResourceKey=margin}" DisplayColorAndName="True" VerticalAlignment="Center" SelectedColorChanged="cp2_SelectedColorChanged" MouseMove="cp_MouseMove" MouseDown="cp_MouseUpDown" />

            <TextBlock Name="txTip" Grid.Row="3" Grid.ColumnSpan="2" FontStyle="Italic" FontWeight="SemiBold" TextWrapping="Wrap" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" Text="Choose the type of gradient, radia or linear, and then choose the first and second color"/>
            
            <Button Name="btnOk" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="{StaticResource ResourceKey=margin}" FontSize="{StaticResource ResourceKey=textsSize}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonsText}" Click="button_Click" Content="Ok"/>
            <Button Name="btnCancel" Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="{StaticResource ResourceKey=margin}" FontSize="{StaticResource ResourceKey=textsSize}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonsText}" Click="button_Click" Content="Cencel"/>

            <Border Name="border" Grid.Row="0" Grid.Column="2" Grid.RowSpan="6" Margin="{StaticResource ResourceKey=margin}" Background="Black" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=bordersWidth}" CornerRadius="{StaticResource ResourceKey=loginCornerRadius}">
            </Border>
        </Grid>
    </Border>
</Window>
