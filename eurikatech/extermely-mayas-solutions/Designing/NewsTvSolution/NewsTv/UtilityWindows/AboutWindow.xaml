<Window x:Class="UtilityWindows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Title="About Window" Width="800" Height="600"
        MouseDown="Window_MouseDown" MouseMove="Window_MouseMove" MouseUp="Window_MouseUp">
    <Window.Resources>
        <ResourceDictionary Source="windowDictionary.xaml"/>
    </Window.Resources>

    <Canvas Name="canvas">      
        <Border Name="logoPanel" Background="{StaticResource ResourceKey=backgrounds}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=bordersWidth}" CornerRadius="{StaticResource ResourceKey=loginCornerRadius}" Opacity=".9" Canvas.Right="0" Canvas.Bottom="0">
            <Image Stretch="Fill" Name="imgLogo" Margin="{StaticResource ResourceKey=margin}" Source="/NewsTv;component/Library/Images/logo_Style.png"/>
        </Border>

        <Border Name="AboutGrid" Background="{StaticResource ResourceKey=backgrounds}" BorderBrush="{StaticResource ResourceKey=borders}" BorderThickness="{StaticResource ResourceKey=bordersWidth}" Opacity=".98" CornerRadius="{StaticResource ResourceKey=loginCornerRadius}">
            <Grid Margin="{StaticResource ResourceKey=margin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                
                <Label Name="txHeader" Grid.Row="0" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=headers}" FontSize="{StaticResource ResourceKey=headersSize}" HorizontalAlignment="Center" Content="NEWS TV"/>
                <TextBlock Name="txRegNumber" Grid.Row="1" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=headers}" FontSize="{StaticResource ResourceKey=textsSize}" HorizontalAlignment="Center" Text="1.0.0.0"/>

                <TextBlock Name="txProgramInfo" Grid.Row="2" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" HorizontalAlignment="Center" Text="The most powerful tools for news studios."/>
                <TextBlock Name="txDesigner" Grid.Row="3" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" HorizontalAlignment="Center" Text="Designed By: Mayas Faraj"/>
                <TextBlock Name="txCompany" Grid.Row="4" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" HorizontalAlignment="Center" Text="For Syria Company"/>
                <TextBlock Name="txDate" Grid.Row="5" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=texts}" FontSize="{StaticResource ResourceKey=textsSize}" HorizontalAlignment="Center" Text="Release Date: 10/7/2013"/>

                <Button Grid.Row="7" Name="btnBack" HorizontalAlignment="Center" Margin="{StaticResource ResourceKey=margin}" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=buttonsText}" FontSize="{StaticResource ResourceKey=textsSize}" Content="Back" Click="btnBack_Click"/>
                <Label Name="txFooter" Grid.Row="8" Margin="{StaticResource ResourceKey=margin}" Foreground="{StaticResource ResourceKey=footers}" FontSize="{StaticResource ResourceKey=footersSize}" HorizontalAlignment="Center" Content="...For Syria..."/>
            </Grid>
        </Border>
    </Canvas>
</Window>