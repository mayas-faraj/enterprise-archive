Private Sub Form_Activate()
    Form_Load
End Sub

Private Sub Form_Load()
    Dim selSQL
    '''''''''''''''''''''''''''''''''''''''''''
    '        Clear the Last Saved Data        '
    '''''''''''''''''''''''''''''''''''''''''''
    For Rep = 0 To 29
        LblAutoNum(Rep).Caption = ""
        txtName(Rep).Text = ""
        TxtDate(Rep).Text = ""
        txtImport(Rep).Text = ""
        TxtImportDes(Rep).Text = ""
        LblAutoNum(Rep).Caption = ""
        TxtExDate(Rep).Text = ""
        txtExport(Rep).Text = ""
        TxtExportDes(Rep).Text = ""
        txtRegNum(Rep).Text = ""
    Next Rep
    TxtView(2).Text = 0
    TxtView(3).Text = 0
    
    '''''''''''''''''''''''''''''''''''''''''''
    '           DataBase Connection           '
    '''''''''''''''''''''''''''''''''''''''''''
    Dim Appl As String
    Appl = App.Path
    If Right(Appl, 1) <> "\" Then Appl = Appl & "\"
    Set ADO = CreateObject("ADODB.connection")
    ADO.ConnectionString = "Provider=Microsoft.Jet.OLEDB.4.0;" & "Data Source=" & Appl & "file.mdb"
    ADO.Open
    selSQL = "select * from tblimport where dmonth='" & MonthNum & "' and dyear='" & YearNum & "'"
    Set RS = ADO.Execute(selSQL)
    
    '''''''''''''''''''''''''''''''''''''''''''
    '          Fill Tabels With Data          '
    '''''''''''''''''''''''''''''''''''''''''''

    For Rep = 0 To 29
        If RS.EOF Then Exit For
        LblAutoNum(Rep).Caption = Rep
        txtName(Rep).Text = RS("dname")
        TxtDate(Rep).Text = RS("ddate") & "\" & RS("dmonth") & "\" & RS("dyear")
        txtImport(Rep).Text = RS("dimport")
        TxtImportDes(Rep).Text = RS("dimportdes")
        TxtView(2).Text = TxtView(2).Text + RS("dimport")
        RS.MoveNext
    Next Rep
    
    selSQL = "select * from tblexport where dmonth='" & MonthNum & "' and dyear='" & YearNum & "'"
    Set RS = ADO.Execute(selSQL)
    For Rep = 0 To 29
        If RS.EOF Then Exit For
        LblAutoNum(Rep).Caption = Rep
        TxtExDate(Rep).Text = RS("ddate") & "\" & RS("dmonth") & "\" & RS("dyear")
        txtExport(Rep).Text = RS("dexport")
        TxtExportDes(Rep).Text = RS("dexportdes")
        txtRegNum(Rep).Text = RS("dregnum")
        TxtView(3).Text = TxtView(3).Text + RS("dexport")
        RS.MoveNext
    Next Rep
    
    '''''''''''''''''''''''''''''''''''''''''''
    '             Other Contorls              '
    '''''''''''''''''''''''''''''''''''''''''''

    ADO.Close
    Set ADO = Nothing
    txtMoney.Text = GetSetting("Database", "Values", "Money", "1000000")
