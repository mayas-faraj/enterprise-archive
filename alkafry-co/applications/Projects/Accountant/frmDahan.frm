Private Sub Form_Load()
    For Rep = 1 To 31
        cmbDay.List(Rep - 1) = Rep
        If Rep <= 12 Then cmbMonth.List(Rep - 1) = Rep
    Next Rep
    cmbDay.Text = Day(Now)
    cmbMonth.Text = Month(Now)
    cmbYear.Text = Year(Now)
    
    Grid.Cols = 5
    Grid.ColWidth(0) = 2500
    Grid.ColWidth(1) = 1500
    Grid.ColWidth(2) = 1000
    Grid.ColWidth(3) = 1000
    Grid.ColWidth(4) = 1500
    Grid.ColAlignment(0) = 3
    Grid.ColAlignment(1) = 3
    Grid.ColAlignment(2) = 3
    Grid.ColAlignment(3) = 3
    Grid.ColAlignment(4) = 3
    Grid.TextMatrix(0, 0) = "≈”„ «·„‰ Ã"
    Grid.TextMatrix(0, 1) = "«· «—ÌŒ"
    Grid.TextMatrix(0, 2) = "«·⁄œœ"
    Grid.TextMatrix(0, 3) = "«·≈›—«œÌ"
    Grid.TextMatrix(0, 4) = "«·≈Ã„«·Ì"

    
    cmbName.Text = "“»Ê‰ ⁄«»—"
    Appl = App.Path
    If Right(Appl, 1) <> "\" Then Appl = Appl & "\accountdata.mdb"
    Set ADO = CreateObject("ADODB.connection")
    ADO.connectionstring = "Provider=Microsoft.Jet.OLEDB.4.0;" & "Data Source=" & Appl
    ADO.open
    SelSQL = "select ddahan from tbldahan group by ddahan"
    Set Rs = ADO.execute(SelSQL)
    Rep = 0
    Do While Not Rs.EOF
        cmbName.List(Rep) = Rs("ddahan")
        Rep = Rep + 1
        Rs.movenext
    Loop
    
End Sub

Private Sub Text3_Change()
    If IsNumeric(Text4.Text) = True And IsNumeric(Text3.Text) = True Then Text5.Text = CDbl(Text3.Text) * CDbl(Text4.Text)
End Sub

Private Sub Text4_Change()
    If IsNumeric(Text4.Text) = True And IsNumeric(Text3.Text) = True Then Text5.Text = CDbl(Text3.Text) * CDbl(Text4.Text)
End Sub

Private Sub Text7_LostFocus()
