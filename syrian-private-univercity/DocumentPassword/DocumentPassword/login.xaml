<Window x:Class="DocumentPassword.login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{StaticResource ResourceKey=background}"
        FlowDirection="RightToLeft"
        MaxHeight="250" MaxWidth="350" MinHeight="250" MinWidth="350"
        Title="login" Height="250" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="ترجمة منهاج اللغة الإنكليزية الفرع العلمي" FontSize="18" TextAlignment="Center" Foreground="{StaticResource ResourceKey=captions}"/>
        
        <TextBlock Grid.Row="1" Text="لم تتم ترخيص تلك النسخة, يرجى إدخال مفتاح الترخيص في مربع النص أدناه" Foreground="{StaticResource ResourceKey=texts}"/>
        <TextBox Grid.Row="2" Name="txRequest" Margin="4" Foreground="{StaticResource ResourceKey=texts}" IsReadOnly="True" Background="LightGray" />
        <TextBox Grid.Row="3" Name="txCode" Margin="4" Foreground="{StaticResource ResourceKey=texts}" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible"/>
        
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="إدخال المنتج" Margin="2" Name="btnRun" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=texts}" Click="btnRun_Click" />
            <Button Grid.Column="1" Content="الحصول على المفتاح" Margin="2" Name="btnClear" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=texts}" Click="btnClear_Click" />
            <Button Grid.Column="2" Content="خروج" Margin="2" Name="btnExit" Background="{StaticResource ResourceKey=buttons}" Foreground="{StaticResource ResourceKey=texts}" Click="btnExit_Click" />
        </Grid>        
    </Grid>
</Window>

    