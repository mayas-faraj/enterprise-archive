$(document).ready(function(){var e="";var f="";var d=[];Master.getHeader(function(a){$("body").prepend(a);SessionAccess.getSessionUser(function(b){jid=StropheAccess.getJid(b);$("#headerUserNameLabel").html(jid);DataAccess.findNodeByName(b,function(h){try{$("#headerUserFullNameLabel").html(JSON.parse(h).title)}catch(c){console.log(c)}});SessionAccess.getSessionRoleId(function(c){if(c.trim()==2){SessionAccess.getSessionNodeId(function(h){$("#headerUserNameLabel").html(StropheAccess.getJid(h));DataAccess.findAdminByName(h,function(j){try{$("#headerUserFullNameLabel").html(JSON.parse(j).full_name)}catch(g){console.log(g)}})});$("#headerUserList>a").remove()}});SessionAccess.getSessionTone(function(c){f=c;StropheAccess.connection.connect(jid,f,function(m){var n=$("#footerStatusLabel");var l=$("#headerNotifyCount");var k=$("#headerNotifyList");if(m==Strophe.Status.CONNECTING){n.text("جاري الاتصال...")}else{if(m==Strophe.Status.AUTHFAIL||m==Strophe.Status.DISCONNECTED){n.text("غير متصل.")}else{if(m==Strophe.Status.CONNECTED||m==Strophe.Status.ATTACHED){$(document).trigger("connected");n.text("متصل");StropheAccess.connection.sendIQ($pres().c("priority").t("5").up().c("c",{xmlns:"http://jabber.org/protocol/caps",node:"http://psi-im.org/caps",ver:"caps-b75d8d2b25",ext:"ca cs ep-notify-2 htm"}));setInterval(function(){StropheAccess.connection.sendPresence($pres())},300000);if($("#headerNotifyDiv").length==1){InterfaceAccess.loadReportsNotification("7",function(i){if(i!=null&&i!=""){var g=i.split("<br />");for(var p=0;p<g.length;p++){if(g[p]!=""){var h=JSON.parse(g[p]);k.append('<div class="page-banner-item"><a href="stream.html?id='+h.RowKey+'"><img class="page-banner-drop-image" src="imgs/node/'+h.es+'.png"/><label class="page-banner-drop-text">'+h.text+"</label></a></div>");var j=h.publisher+";"+h.text+";"+h.timestamp.toString();d.push(j)}}}else{k.html('<div class="page-banner-item">لا يوجد اشعارات.</div>')}});SessionAccess.getReportNotification(function(g){if(g!=null&&g.trim()!=""){l.html(g)}});StropheAccess.connection.addHandler(function(x){if($(x).is("message")&&$(x).attr("type")!="error"){var h=Strophe.getBareJidFromJid($(x).attr("from"));var u=$(x).find("body").text();if(h==StropheAccess.XMPP_SERVER||h==StropheAccess.getJid("ehq")){var i=/\d+@\w+\.\w+/;if(i.test(u)){var v=i.exec(u)[0];StropheAccess.presenceSubscribe(v);console.log("presend subscribtion from ",v);if(h==StropheAccess.XMPP_SERVER){StropheAccess.getNodes(function(o){$(o).find("affiliation").each(function(){var p=$(this).attr("node");if(p!="commands"&&p!="es_updates"){StropheAccess.getUsers(p,function(q){$(q).find("affiliation").each(function(){if(v==$(this).attr("jid")){StropheAccess.sendMessage([p],u);console.log("sending message:",p,u)}})})}})})}}}else{try{var g=JSON.parse(u);var t=g.publisher+";"+g.text+";"+g.timestamp.toString();if(d.indexOf(t)==-1){d.push(t);var w=parseInt(l.text());if(isNaN(w)){w=0}if(k.find("a").length==0){k.html("")}l.text(w+1);if(k.find("div").length>=7){k.find("div:last-child").remove()}k.prepend('<div class="page-wbanner-item"><a href="stream.html?id='+g.id+'"><img class="page-banner-drop-image" src="imgs/node/'+g.es+'.png"/><label class="page-banner-drop-text">'+g.text+"</label></a></div>");SessionAccess.saveReportNotification(l.html())}}catch(j){console.log(j)}}}return true})}}}}})})});if($("#headerCommandDiv").length==1){InterfaceAccess.getCommands("0","5",function(j){if(j!=null&&j.length>0){var c=j.split("<br />");for(var i=0;i<c.length;i++){console.log(c[i]);if(c[i]!=""){var b=JSON.parse(c[i]);$("#headerCommandList").append('<div class="page-banner-item"><a href="commands.html?id='+b.RowKey+'"><img class="page-banner-drop-image" src="imgs/commands.png"/><label class="page-banner-drop-text">'+b.text+"</label></a></div>")}}}})}$("#headerLogout").click(function(){StropheAccess.connection.sendPresence($pres({type:"unavailable"}));StropheAccess.connection.disconnect();SessionAccess.destroySession();document.location="login.html"});$("html").click(function(){if($("#headerNotifyList").css("display")=="block"){$("#headerNotifyList").slideUp()}if($("#headerCommandList").css("display")=="block"){$("#headerCommandList").slideUp()}if($("#headerUserList").css("display")=="block"){$("#headerUserList").slideUp()}});$("#headerNotifyDiv").click(function(b){b.stopPropagation();$("#headerNotifyList").slideToggle();$("#headerNotifyCount").html("");SessionAccess.saveReportNotification($("#headerNotifyCount").html());if($("#headerAdminList").css("display")=="block"){$("#headerAdminList").slideUp()}if($("#headerCommandList").css("display")=="block"){$("#headerCommandList").slideUp()}});$("#headerAdminDiv").click(function(b){b.stopPropagation();$("#headerUserList").slideToggle();if($("#headerNotifyList").css("display")=="block"){$("#headerNotifyList").slideUp()}if($("#headerCommandList").css("display")=="block"){$("#headerCommandList").slideUp()}});$("#headerCommandDiv").click(function(b){b.stopPropagation();$("#headerCommandList").slideToggle();if($("#headerNotifyList").css("display")=="block"){$("#headerNotifyList").slideUp()}if($("#headerAdminList").css("display")=="block"){$("#headerAdminList").slideUp()}});Master.getFooter(function(b){$("body").append(b)})})});var Master={masterUrl:"php/Master.php",ajaxCall:function(d,c){$.ajax({url:Master.masterUrl,type:"POST",data:d,success:c})},getHeader:function(b){Master.ajaxCall({op:"getHeader"},b)},getFooter:function(b){Master.ajaxCall({op:"getFooter"},b)},getMainContent:function(b){Master.ajaxCall({op:"getMainContent"},b)},validContent:function(d,c){Master.ajaxCall({op:"validContent",page:d},c)},getVariable:function(e){var f=window.location.href;e=e.replace(/[\[\]]/g,"\\$&");var g=new RegExp("[?&]"+e+"(=([^&#]*)|&|#|$)"),h=g.exec(f);if(!h){return null}if(!h[2]){return""}return decodeURIComponent(h[2].replace(/\+/g," "))}};Master.validContent(window.location.pathname.substring(1),function(b){if(b!=null&&b.trim()!=""){document.write(b)}});function extractDate(g){try{var f=g.split(" ")[0].split("-");var h=g.split(" ")[1].split(":");return new Date(f[2],(parseInt(f[1])-1).toString(),f[0],h[0],h[1],h[2])}catch(e){console.log(e);return new Date()}};
