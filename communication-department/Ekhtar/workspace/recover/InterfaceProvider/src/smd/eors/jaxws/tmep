    //private functions region
    private String[] _getReports(String keywords, String commandId, String userId, String row1, String row2,
            String date1, String date2, String longitude1, String latitude1,
            String longitude2, String latitude2, boolean realtimeOnly, boolean sortByDate, boolean reverseSort)
    {
        try
        {
            GeoRect geoRect=new GeoRect();

            //checking coordinates double format
            if(geoRect.valueOf(longitude1, latitude1, longitude2, latitude2))
            {
                //checking date time format
                long startDate=parseDate(date1);
                long endDate=parseDate(date2);

                if(startDate>endDate && endDate!=0)
                {
                    long temp=startDate;
                    startDate=endDate;
                    endDate=temp;
                }

                if(startDate!=-1&&endDate!=-1)
                {
                    Report[] reports = DataAccess.getReports(row1, row2, startDate, endDate, commandId, userId, keywords, ReportState.all, geoRect.startLongitude, geoRect.startLatitude, geoRect.endLongitude, geoRect.endLatitude, 0, realtimeOnly, sortByDate, reverseSort);
                    String[] result=new String[reports.length];
                    
                    for(int i=0;i<reports.length;i++)
                        result[i]=reports[i].toShortJsonString(); 
                    
                    return result;
                }
                else
                {
                    return new String[] {"//Date values are not in an valid format."};
                }
            }
            else
            {
                return new String[] {"//Coordinates are not in an valid number format."};
            }
        }
        catch(Exception ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex,new Parameter("longitude1",longitude1), new Parameter("latitude1",latitude1), 
                        new Parameter("longitude2",longitude2), new Parameter("latitude2",latitude2));
            return new String[] {ex.getMessage()};
        }
    }
    
