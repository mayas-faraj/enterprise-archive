    private String[] _getUsersNavigation(String row1, String row2,
            String date1, String date2, String longitude1, String latitude1,
            String longitude2, String latitude2, NavigationType navigationType)
    {
        try
        {
            GeoRect geoRect=new GeoRect();

            //checking coordinates double format
            if(geoRect.valueOf(longitude1, latitude1, longitude2, latitude2))
            {
                //checking date time format
                long startDate=parseDate(date1);
                long endDate=parseDate(date2);

                if(startDate>endDate && endDate!=0)
                {
                    long temp=startDate;
                    startDate=endDate;
                    endDate=temp;
                }

                if(startDate!=-1&&endDate!=-1)
                {
                    User[] users=DataAccess.getUsersNavigations(row1, row2, startDate, endDate, geoRect.startLongitude, geoRect.startLatitude, geoRect.endLongitude, geoRect.endLatitude, LocationState.all, false, navigationType);
                    List<String> result=new ArrayList<String>();
                    
                    for(int i=0;i<users.length;i++)
                        if(navigationType==NavigationType.userName)
                        {
                            if(users[i]!=null)
                            result.add(users[i].getName());
                        }
                        else if(navigationType==NavigationType.lastPoint)
                        {
                            if(users[i].getNavigations()!=null && users[i].getNavigations().length>0)
                                result.add(users[i].getNavigations()[0].toJsonString());
                        }
                        else
                            result.add(users[i].toShortJsonString().replace("\\\"", "\""));
                    
                    return result.toArray(new String[0]);
                }
                else
                {
                    return new String[] {"//Date values are not in an valid format."};
                }
            }
            else
            {
                return new String[] {"//Coordinates are not in an valid number format."};
            }
        }
        catch(Exception ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex,new Parameter("longitude1",longitude1), new Parameter("latitude1",latitude1), 
                        new Parameter("longitude2",longitude2), new Parameter("latitude2",latitude2));
            return new String[] {ex.getMessage()};
        }
    }


    private long parseDate(String dateValue)
    {
        try
        {
            if(dateValue==null||dateValue==""|| dateValue=="\"\"")
                return 0;
            else
            {
                Date date;
                
                try
                {
                    date=stampFormatter.parse(dateValue);
                }
                catch(ParseException ex)
                {
                    date=dateFormatter.parse(dateValue);
                }
                
                return date.getTime();
            }
        }
        catch (ParseException ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex,new Parameter("dateValue",dateValue),new Parameter("dateValue.length",String.valueOf(dateValue.length())));

            return 0;
        }
    }
    

    
    private String timespanStartDate(String timespan)
    {
        String startDate;
        long span;

        try
        {
            span=Long.parseLong(timespan);
        }
        catch(NumberFormatException ex)
        {
            return "";
        }

        if(span!=0)
        {
            Date date=new Date((new Date()).getTime()-(span*1000*60));
            startDate=dateFormatter.format(date);
        }
        else
            startDate="";
        
        return startDate;
    }


