    public static Navigation[] getNavigations(String hexStartRow, String hexStopRow, long startTimestamp, long endTimestamp, String userId, double startLongitude, double startLatitude, double endLongitude, double endLatitude, LocationState locationState, boolean realtimeOnly, boolean lastUserPoint, boolean reverseSort)
    {
        //precondition: navigationTable is not null
        
        //scan start and stop processing
        byte[] startRow=bytesFromHex(hexStartRow);
        byte[] stopRow=bytesFromHex(hexStopRow);
        
        Scan scan=setupScan(startRow, stopRow, startTimestamp, endTimestamp);
        scan.setReversed(reverseSort);
        
        FilterList filters=new FilterList(Operator.MUST_PASS_ALL);
        
        //setup user filter
        if(userId!=null && userId!="")
        {
            SingleColumnValueFilter userFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_USER), CompareOp.EQUAL, Bytes.toBytes(userId));
            userFilter.setFilterIfMissing(true);
            filters.addFilter(userFilter);
        }
        
        //setup location state filter
        if(locationState==LocationState.cell)  
        {
            SingleColumnValueFilter locationFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_CGI), CompareOp.NOT_EQUAL, Bytes.toBytes(""));
            locationFilter.setFilterIfMissing(true);
            filters.addFilter(locationFilter);
        }
        else if(locationState==LocationState.gps)
        {
            SingleColumnValueFilter locationFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_ACCURACY), CompareOp.NOT_EQUAL, Bytes.toBytes(0f));
            locationFilter.setFilterIfMissing(true);
            filters.addFilter(locationFilter);
        }
        
        //setup coordinate filter
        if(startLongitude!=0 || endLongitude!=0 || startLatitude !=0 || endLatitude!=0)
        {
            SingleColumnValueFilter startLogitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LONGITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLongitude));
            SingleColumnValueFilter endLongitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LONGITUDE),CompareOp.LESS,Bytes.toBytes(endLongitude));
            SingleColumnValueFilter startLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LATITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLatitude));
            SingleColumnValueFilter endLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LATITUDE),CompareOp.LESS,Bytes.toBytes(endLatitude));
            
            startLogitudeFilter.setFilterIfMissing(true);
            endLongitudeFilter.setFilterIfMissing(true);
            startLatitudeFilter.setFilterIfMissing(true);
            endLatitudeFilter.setFilterIfMissing(true);
            FilterList locationFilter=new FilterList(Operator.MUST_PASS_ALL);
             
            locationFilter.addFilter(startLogitudeFilter);
            locationFilter.addFilter(endLongitudeFilter);
            locationFilter.addFilter(startLatitudeFilter);
            locationFilter.addFilter(endLatitudeFilter);
 
            filters.addFilter(locationFilter);
        }
        
        //setup filters
        if(filters.getFilters()!=null && !filters.getFilters().isEmpty())
            scan.setFilter(filters);

        //getting result
        //List<Navigation> navigations=new ArrayList<Navigation>();
        HashMap<String, Navigation> navigations=new HashMap<String, Navigation>();
        
        //fetch real time navigation 
        try
        {
            ResultScanner results=navigationRealtimeTable.getScanner(scan);
            Navigation tempNavigation;
            
            if(results!=null)
                for(Result result:results)
                {
                    tempNavigation=valueOfNavigation(result);
                    String saltKey;
                    
                    if(lastUserPoint)
                        saltKey=tempNavigation.getUser();
                    else
                        saltKey=Bytes.toString(result.getRow());
   
                    //critical operation
                    navigations.put(saltKey,tempNavigation);  
                }
        }
        catch (IOException ex)
        {
            if(logStream!=null)
            {
                String startValue=(startRow==null)?"null":startRow.toString();
                String stopValue=(stopRow==null)?"null":stopRow.toString();
                logStream.writeLog(ex, new Parameter("startRow",startValue), new Parameter("stopRow",stopValue), new Parameter("startTimestamp",String.valueOf(startTimestamp)), new Parameter("endTimestamp",String.valueOf(endTimestamp))
                        , new Parameter("userId",userId), new Parameter("locationState",locationState.name()), new Parameter("startlongitude",String.valueOf(startLongitude))
                        , new Parameter("endLongitude",String.valueOf(endLongitude)), new Parameter("startLatitude",String.valueOf(startLatitude)), new Parameter("endLatitude",String.valueOf(endLatitude))
                        , new Parameter("lastUserPoint",String.valueOf(lastUserPoint)), new Parameter("realtimeOnly",String.valueOf(realtimeOnly)), new Parameter("reverseSort",String.valueOf(reverseSort)));
            }
        }
        
        //fetch historical navigation
        if(!realtimeOnly)
        {
            try
            {
                ResultScanner results=navigationTable.getScanner(scan);
                Navigation tempNavigation;
                
                if(results!=null)
                    for(Result result:results)
                    {
                        tempNavigation=valueOfNavigation(result);
                        String saltKey;
                        
                        if(lastUserPoint)
                            saltKey=tempNavigation.getUser();
                        else
                            saltKey=Bytes.toString(result.getRow());
       
                        //critical operation
                        navigations.put(saltKey,tempNavigation);  
                    }
            }
            catch (IOException ex)
            {
                if(logStream!=null)
                {
                    String startValue=(startRow==null)?"null":startRow.toString();
                    String stopValue=(stopRow==null)?"null":stopRow.toString();
                    logStream.writeLog(ex, new Parameter("startRow",startValue), new Parameter("stopRow",stopValue), new Parameter("startTimestamp",String.valueOf(startTimestamp)), new Parameter("endTimestamp",String.valueOf(endTimestamp))
                            , new Parameter("userId",userId), new Parameter("locationState",locationState.name()), new Parameter("startlongitude",String.valueOf(startLongitude))
                            , new Parameter("endLongitude",String.valueOf(endLongitude)), new Parameter("startLatitude",String.valueOf(startLatitude)), new Parameter("endLatitude",String.valueOf(endLatitude))
                            , new Parameter("lastUserPoint",String.valueOf(lastUserPoint)), new Parameter("realtimeOnly",String.valueOf(realtimeOnly)), new Parameter("reverseSort",String.valueOf(reverseSort)));
                }
            }
        }
        
        return navigations.values().toArray(new Navigation[0]);
    }
    
    public static Navigation[] getUserNavigations(String user, long startTimestamp, long endTimestamp, double startLongitude, double startLatitude, double endLongitude, double endLatitude, LocationState locationState)
    {
        Navigation[] n1=getUserNavigations(user, startTimestamp, endTimestamp, startLongitude, startLatitude, endLongitude, endLatitude, locationState, true);
        Navigation[] n2=getUserNavigations(user, startTimestamp, endTimestamp, startLongitude, startLatitude, endLongitude, endLatitude, locationState, false);
