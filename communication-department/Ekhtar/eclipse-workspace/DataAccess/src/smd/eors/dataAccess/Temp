    public static Report getReport(String hexReportId)
    {
        //precondition: reportTable is not null
        byte[] reportId=bytesFromHex(hexReportId);
        
        if(reportId==null)
            return null;
        
        Get get=new Get(reportId);
        
        if(get!=null)
        {
            try
            {
                //detect report if it is on a real time
                Result reportResult;
                
                if(isRealtimeReport(reportId))
                    reportResult=reportRealtimeTable.get(get);
                else
                    reportResult=reportTable.get(get);
                
                //process the report result
                if(reportResult!=null && !reportResult.isEmpty())
                    //critical operation
                    return valueOfReport(reportResult);
            }
            catch (IOException ex)
            {
                if(logStream!=null)
                    logStream.writeLog(ex, new Parameter("hexReportId",hexReportId));
            }
        }
        
        //report is not exist
        return null;
    }
    
