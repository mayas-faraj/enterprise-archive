    public static Report[] getReports(String hexStartRow, String hexStopRow, long startTimestamp, long endTimestamp, String commandId, String userId, String keyword, ReportState processedState, double startLongitude, double startLatitude, double endLongitude, double endLatitude, float lowestImportance, boolean realtimeOnly, boolean sortByDate, boolean reverseSort)
    {
        //precondition: reportTable is not null
        
        //scan start and stop processing
        byte[] startRow=bytesFromHex(hexStartRow);
        byte[] stopRow=bytesFromHex(hexStopRow);
        
        Scan scan=setupScan(startRow, stopRow, startTimestamp, endTimestamp);
        scan.setReversed(reverseSort);
        
        FilterList filters=new FilterList(Operator.MUST_PASS_ALL);
        
        //setup command filter
        if(commandId!=null && commandId!="")
        {
            SingleColumnValueFilter commandFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_COMMAND), CompareOp.EQUAL, Bytes.toBytes(commandId));
            commandFilter.setFilterIfMissing(true);
            filters.addFilter(commandFilter);
        }
        
        //setup user filter
        if(userId!=null && userId!="")
        {
            SingleColumnValueFilter userFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_USER), CompareOp.EQUAL, Bytes.toBytes(userId));
            userFilter.setFilterIfMissing(true);
            filters.addFilter(userFilter);
        }
        
        //setup keyword filter
        if(keyword!=null && keyword!="")
        {
            //TODO change TEXT info KEYWORDS
            SingleColumnValueFilter keywordFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_TEXT), CompareOp.EQUAL, new SubstringComparator(keyword));
            keywordFilter.setFilterIfMissing(true);
            filters.addFilter(keywordFilter);
        }
        
        //setup processed filter
        if(processedState==ReportState.processed)  
        {
            SingleColumnValueFilter processedFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_PROCESSED), CompareOp.EQUAL, Bytes.toBytes(true));
            processedFilter.setFilterIfMissing(true);
            filters.addFilter(processedFilter);
        }
        else if(processedState==ReportState.unprocessed)
        {
            SingleColumnValueFilter processedFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_PROCESSED), CompareOp.NOT_EQUAL, Bytes.toBytes(true));
            processedFilter.setFilterIfMissing(false);
            filters.addFilter(processedFilter);
        }
        
        //setup lower importance filter
        if(lowestImportance>0)
        {
            //TODO replace by search on report id value
            SingleColumnValueFilter importanceFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_CATEGORY), Bytes.toBytes(DataSchema.REPORT_CATEGORY_IMPORTANCE), CompareOp.GREATER_OR_EQUAL, Bytes.toBytes(lowestImportance));
            importanceFilter.setFilterIfMissing(true);
            filters.addFilter(importanceFilter);
        }
        
        //setup coordinate filter
        if(startLongitude!=0 || endLongitude!=0 || startLatitude !=0 || endLatitude!=0)
        {
            SingleColumnValueFilter startLogitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LONGITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLongitude));
            SingleColumnValueFilter endLongitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LONGITUDE),CompareOp.LESS,Bytes.toBytes(endLongitude));
            SingleColumnValueFilter startLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LATITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLatitude));
            SingleColumnValueFilter endLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LATITUDE),CompareOp.LESS,Bytes.toBytes(endLatitude));
            SingleColumnValueFilter startCellLogitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLONGITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLongitude));
            SingleColumnValueFilter endCellLongitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLONGITUDE),CompareOp.LESS,Bytes.toBytes(endLongitude));
            SingleColumnValueFilter startCellLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLATITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLatitude));
            SingleColumnValueFilter endCellLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLATITUDE),CompareOp.LESS,Bytes.toBytes(endLatitude));
        
            startLogitudeFilter.setFilterIfMissing(true);
            endLongitudeFilter.setFilterIfMissing(true);
            startLatitudeFilter.setFilterIfMissing(true);
            endLatitudeFilter.setFilterIfMissing(true);
            startCellLogitudeFilter.setFilterIfMissing(true);
            endCellLongitudeFilter.setFilterIfMissing(true);
            startCellLatitudeFilter.setFilterIfMissing(true);
            endCellLatitudeFilter.setFilterIfMissing(true);
            
            FilterList gpsFilters=new FilterList(Operator.MUST_PASS_ALL);
            FilterList cellFilters=new FilterList(Operator.MUST_PASS_ALL);
            
            gpsFilters.addFilter(startLogitudeFilter);
            gpsFilters.addFilter(endLongitudeFilter);
            gpsFilters.addFilter(startLatitudeFilter);
            gpsFilters.addFilter(endLatitudeFilter);
            cellFilters.addFilter(startCellLogitudeFilter);
            cellFilters.addFilter(endCellLongitudeFilter);
            cellFilters.addFilter(startCellLatitudeFilter);
            cellFilters.addFilter(endCellLatitudeFilter);
    
            FilterList coodinateFilter=new FilterList(Operator.MUST_PASS_ONE);
            coodinateFilter.addFilter(gpsFilters);
            coodinateFilter.addFilter(cellFilters);
            
            filters.addFilter(coodinateFilter);
        }
        
        //setup filters
        if(filters.getFilters()!=null && !filters.getFilters().isEmpty())
            scan.setFilter(filters);

        //getting result
        List<Report> realtimeReports=new ArrayList<Report>();
        
        //fetch real time reports
        try
        {
            ResultScanner results=reportRealtimeTable.getScanner(scan);
            
            if(results!=null)
                for(Result result:results)
                    realtimeReports.add(valueOfReport(result));   
        }
        catch (IOException ex)
        {
            if(logStream!=null)
            {
                String startValue=(startRow==null)?"null":startRow.toString();
                String stopValue=(stopRow==null)?"null":stopRow.toString();
                logStream.writeLog(ex, new Parameter("startRow",startValue), new Parameter("stopRow",stopValue), new Parameter("startTimestamp",String.valueOf(startTimestamp)), new Parameter("endTimestamp",String.valueOf(endTimestamp))
                        , new Parameter("commandId",commandId), new Parameter("userId",userId), new Parameter("keyword",keyword), new Parameter("startlongitude",String.valueOf(startLongitude))
                        , new Parameter("endLongitude",String.valueOf(endLongitude)), new Parameter("startLatitude",String.valueOf(startLatitude)), new Parameter("endLatitude",String.valueOf(endLatitude))
                        , new Parameter("lowestImportance",String.valueOf(lowestImportance)), new Parameter("realtimeOnly",String.valueOf(realtimeOnly)), new Parameter("processedState",processedState.name()));
            }
        }
        
        if(!realtimeOnly)
        {
            List<Report> historicalReports=new ArrayList<Report>();
            
            //fetch historical reports
            try
            {
                ResultScanner results=reportTable.getScanner(scan);
                
                if(results!=null)
                    for(Result result:results)
                        historicalReports.add(valueOfReport(result));   
            }
            catch (IOException ex)
            {
                if(logStream!=null)
                {
                    String startValue=(startRow==null)?"null":startRow.toString();
                    String stopValue=(stopRow==null)?"null":stopRow.toString();
                    logStream.writeLog(ex, new Parameter("startRow",startValue), new Parameter("stopRow",stopValue), new Parameter("startTimestamp",String.valueOf(startTimestamp)), new Parameter("endTimestamp",String.valueOf(endTimestamp))
                            , new Parameter("commandId",commandId), new Parameter("userId",userId), new Parameter("keyword",keyword), new Parameter("startlongitude",String.valueOf(startLongitude))
                            , new Parameter("endLongitude",String.valueOf(endLongitude)), new Parameter("startLatitude",String.valueOf(startLatitude)), new Parameter("endLatitude",String.valueOf(endLatitude))
                            , new Parameter("lowestImportance",String.valueOf(lowestImportance)), new Parameter("realtimeOnly",String.valueOf(realtimeOnly)), new Parameter("processedState",processedState.name()));
                }
            }
  
          //merge reports
          realtimeReports.addAll(historicalReports);
        }
        
        //sorting report
        if(sortByDate)
        {
            Collections.sort(realtimeReports, new ReportTimeComparator());
            if(reverseSort)
                Collections.reverse(realtimeReports);
        }
        else
            Collections.sort(realtimeReports, new ReportImportanceComparator());
              
        return realtimeReports.toArray(new Report[0]);   
    }
    
    public static boolean putReport(Report report)
    {
        //row key design: importance + real time byte flag + time stamp
        byte[] rowId=report.designRowId();
        
        report.setRowId(rowId);
 
        //put the result
        Put put=new Put(report.getRowId());

        //putting the report info
        put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_ID),Bytes.toBytes(report.getId()));
        
        if(report.getUser()!=null && report.getUser()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_USER),Bytes.toBytes(report.getUser()));
        
        if(report.getCommand()!=null && report.getCommand()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_COMMAND),Bytes.toBytes(report.getCommand()));
        
        if(report.getText()!=null && report.getText()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_TEXT),Bytes.toBytes(report.getText()));
         
        put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_TRUSTY),Bytes.toBytes(report.getTrusty()));
        
        if(report.getIp()!=null && report.getIp()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_IP),Bytes.toBytes(report.getIp()));
        
        if(report.getCellInfo()!=null && report.getCellInfo()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELL_INFO),Bytes.toBytes(report.getCellInfo()));

        if(report.getImei()!=null && report.getImei()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_IMEI),Bytes.toBytes(report.getImei()));
        
        if(report.getImsi()!=null && report.getImsi()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_IMSI),Bytes.toBytes(report.getImsi()));
        
        if(report.getSsn()!=null && report.getSsn()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_SSN),Bytes.toBytes(report.getSsn()));
        
        if(report.getMac()!=null && report.getMac()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_MAC),Bytes.toBytes(report.getMac()));
        
        if(report.getDeviceType()!=null && report.getDeviceType()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_DEVICE_TYPE),Bytes.toBytes(report.getDeviceType()));
        
        if(report.getOs()!=null && report.getOs()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_OS_VERSION),Bytes.toBytes(report.getOs()));
        
        if(report.getComment()!=null && report.getComment()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_COMMENT),Bytes.toBytes(report.getComment()));
        
        if(report.getKeyword()!=null && report.getKeyword()!="")
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_KEYWORDS),Bytes.toBytes(report.getKeyword()));

        if(report.isProcessed())
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_PROCESSED),Bytes.toBytes(report.isProcessed()));

        if(report.getGpsLongitude()!=0)
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LONGITUDE),Bytes.toBytes(report.getGpsLongitude()));

        if(report.getGpsLatitude()!=0)
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LATITUDE),Bytes.toBytes(report.getGpsLatitude()));

        if(report.getCellLongitude()!=0)
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLONGITUDE),Bytes.toBytes(report.getCellLongitude()));

        if(report.getCellLatitude()!=0)
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLATITUDE),Bytes.toBytes(report.getCellLatitude()));

        if(report.getGpsDate()!=null)
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_GPS_DATE),Bytes.toBytes(report.getGpsDate().getTime()));

        if(report.getDate()!=null)
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_DATE),Bytes.toBytes(report.getDate().getTime()));

        //putting the report categories
        put.addColumn(Bytes.toBytes(DataSchema.REPORT_CATEGORY),Bytes.toBytes(DataSchema.REPORT_CATEGORY_IMPORTANCE),Bytes.toBytes(report.getImportance()));

        for(String key:report.getCategories().keySet())
            put.addColumn(Bytes.toBytes(DataSchema.REPORT_CATEGORY),Bytes.toBytes(key),Bytes.toBytes(report.getCategories().get(key)));

        //put the report info table
        try
        {
            reportTable.put(put);
        }
        catch (IOException ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex, new Parameter("hexRowId",report.getHexRowId()),new Parameter("user",report.getUser())
                        , new Parameter("command",report.getCommand()), new Parameter("reportId",String.valueOf(report.getId()))
                        , new Parameter("text",report.getText()), new Parameter("trusty",String.valueOf(report.getTrusty())));
            return false;
        }
        
        return true;
    }
    
    public static boolean updateReportPriority(String hexRowId, float priority)
    {  
        byte[] rowId=bytesFromHex(hexRowId);
        
        if(rowId==null)
            return false;
        
        //detect the target report table, real time of historical
        Table targetReportTable;
 
        if(isRealtimeReport(rowId))
            targetReportTable=reportRealtimeTable;
        else
            targetReportTable=reportTable;
        
        try
        {
            if(priority!=0)
            {
                Put put=new Put(rowId);
                put.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_PRIORITY),Bytes.toBytes(priority));
                targetReportTable.put(put);
            }
            else
            {
                Delete delete=new Delete(rowId);
                delete.addColumn(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_PRIORITY));
                targetReportTable.delete(delete);
            }
            
            return true;
        }
        catch (IOException ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex, new Parameter("hexRowId",hexRowId), new Parameter("prioriry",String.valueOf(priority)));

            return false;
        }
    }
    
