    private static Result getNavigationRow(byte[] startRow, byte[] stopRow, boolean isRealtime)
    {
        //precondition: navigationTable and navitationRealtimeTable is not null
        Table currentNavigationTable;
        
        if(isRealtime)
            currentNavigationTable=navigationRealtimeTable;
        else
            currentNavigationTable=navigationTable;
        
        Scan scan=setupScan(startRow, stopRow, 0 ,0);
        PageFilter filter=new PageFilter(1);
        
        scan.setFilter(filter);
        
        ResultScanner rs;
        try
        {
            rs = currentNavigationTable.getScanner(scan);
            
            if(rs!=null)
                return rs.next();
        }
        catch (IOException ex)
        {
            if(getLogStream()!=null)
            {
                String stringOffset=(startRow==null)?"<Null>":startRow.toString();
                getLogStream().writeLog(ex, new Parameter("stringOffset",stringOffset),new Parameter("isRealtime",String.valueOf(isRealtime)));
            }
        }
        
        return null;   
    }
    
    private static Scan setupScan(byte[] startRow, byte[] stopRow, long startTimestamp, long endTimestamp)
    {
        Scan scan=new Scan();
        
        if(startRow!=null)
            scan.setStartRow(startRow);
        
        if(stopRow!=null)
            scan.setStopRow(stopRow);
        
        try
        {
            if(startTimestamp>0)
                if(endTimestamp>0)
                    scan.setTimeRange(startTimestamp, endTimestamp);
                else
                    scan.setTimeRange(startTimestamp, Long.MAX_VALUE);
            else
                if(endTimestamp>0)
                    scan.setTimeRange(0, endTimestamp);
        }
        catch(IOException ex)
        {
            if(getLogStream()!=null)
                getLogStream().writeLog(ex, new Parameter("startTimestamp",String.valueOf(startTimestamp)),new Parameter("endTimestamp",String.valueOf(endTimestamp)));
        }
        
        return scan;
    }
    
    private static Report valueOfReport(Result result)
    {
        //precondition: none
        if(result==null) 
            return null;
        
        Report report=new Report();
        
        //extract report id
        report.setRowId(result.getRow());

        //getting values into report
        report.setId(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_ID)),0l));
        report.setUser(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_USER)),""));
        report.setCommand(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_COMMAND)),""));
        report.setText(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_TEXT)),""));
        report.setPriority(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_PRIORITY)),0f));
        report.setTrusty(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_TRUSTY)),0));
        report.setIp(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_IP)),""));
        report.setCellInfo(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_CELL_INFO)),""));
