        report.setComment(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_COMMENT)),""));
        report.setKeyword(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_KEYWORDS)),""));
        report.setProcessed(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_PROCESSED)),false));
        report.setGpsDate(new Date(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_GPS_DATE)),0l)));
        
        //extract date
        long timestamp=valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_DATE)),0l);
        
        Cell cell=result.getColumnLatestCell(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_TEXT));
        
        if(cell!=null)
            report.setTimpstamp(cell.getTimestamp());
        
        
        if(timestamp==0)
            timestamp=report.getTimpstamp();
        
        report.setDate(new Date(timestamp));

        //getting category info
        NavigableMap<byte[], byte[]> familyMap = result.getFamilyMap(Bytes.toBytes(DataSchema.REPORT_CATEGORY));

        if(familyMap!=null && familyMap.keySet()!=null)
            for(byte[] key : familyMap.keySet())
            {
                String keyString=Bytes.toString(key);
    
                if(keyString.equals(DataSchema.REPORT_CATEGORY_IMPORTANCE))
                {
                    float value=valueOfBytes(familyMap.get(key), 0f);
                    report.setImportance(value);
                }
                else
                {
                    int value=valueOfBytes(familyMap.get(key), 0);
                    report.getCategories().put(keyString, value);
                }
            }
        
        return report;
    }
 
