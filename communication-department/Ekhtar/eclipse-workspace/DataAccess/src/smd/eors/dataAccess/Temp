        return n;
    }

    public static Navigation[] getUserNavigations(String user, long startTimestamp, long endTimestamp, double startLongitude, double startLatitude, double endLongitude, double endLatitude, LocationState locationState, boolean realtime)
    {
        //precondition: navigationTable is not null
        if(user==null)
            return null;
         
        //define start and stop row
        byte[] userHash=Bytes.toBytes(user.hashCode());
        
        byte[] startRow=Bytes.padTail(userHash, Bytes.SIZEOF_LONG);
        byte[] stopRow=new byte[startRow.length];

        int offset=Bytes.putBytes(stopRow, 0, userHash, 0, userHash.length);
        Bytes.putBytes(stopRow, offset, Bytes.toBytes(Long.MAX_VALUE), 0 ,Bytes.SIZEOF_LONG);
        
        //setup scan
        Scan scan=setupScan(startRow, stopRow, startTimestamp, endTimestamp);
        FilterList filters=new FilterList(Operator.MUST_PASS_ALL);
    
        //setup location state filter
        if(locationState==LocationState.cell)  
        {
            SingleColumnValueFilter locationFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_CGI), CompareOp.NOT_EQUAL, Bytes.toBytes(""));
            locationFilter.setFilterIfMissing(true);
            filters.addFilter(locationFilter);
        }
        else if(locationState==LocationState.gps)
        {
            SingleColumnValueFilter locationFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_ACCURACY), CompareOp.NOT_EQUAL, Bytes.toBytes(0f));
            locationFilter.setFilterIfMissing(true);
            filters.addFilter(locationFilter);
        }
        
        //setup coordinate filter
        if(startLongitude!=0 || endLongitude!=0 || startLatitude !=0 || endLatitude!=0)
        {
            SingleColumnValueFilter startLogitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LONGITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLongitude));
            SingleColumnValueFilter endLongitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LONGITUDE),CompareOp.LESS,Bytes.toBytes(endLongitude));
            SingleColumnValueFilter startLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LATITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLatitude));
            SingleColumnValueFilter endLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.NAVIGATION_INFO),Bytes.toBytes(DataSchema.NAVIGATION_INFO_LATITUDE),CompareOp.LESS,Bytes.toBytes(endLatitude));
            
            startLogitudeFilter.setFilterIfMissing(true);
            endLongitudeFilter.setFilterIfMissing(true);
            startLatitudeFilter.setFilterIfMissing(true);
            endLatitudeFilter.setFilterIfMissing(true);
            FilterList locationFilter=new FilterList(Operator.MUST_PASS_ALL);
             
            locationFilter.addFilter(startLogitudeFilter);
            locationFilter.addFilter(endLongitudeFilter);
            locationFilter.addFilter(startLatitudeFilter);
            locationFilter.addFilter(endLatitudeFilter);
 
            filters.addFilter(locationFilter);
        }
        
        //setup filters
        if(filters.getFilters()!=null && !filters.getFilters().isEmpty())
            scan.setFilter(filters);
  
        //fetch navigations
        List<Navigation> navigations=new ArrayList<Navigation>();
        
        try
        {
            Table currentNavigationTable;
            
            if(realtime)
                currentNavigationTable=navigationRealtimeTable;
            else
                currentNavigationTable=navigationTable;
                    
            ResultScanner results=currentNavigationTable.getScanner(scan);
            Navigation tempNavigation;
            
            if(results!=null)
                for(Result result:results)
                {
                    tempNavigation=valueOfNavigation(result);
                    
                    //critical operation
                    navigations.add(tempNavigation);              
                }
        }
        catch (IOException ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex,new Parameter("user",user),new Parameter("realtime",String.valueOf(realtime)));
        }
        
        return navigations.toArray(new Navigation[0]); 
    }
    
    public static User[] getUsersNavigations(String hexStartRow, String hexStopRow, long startTimestamp, long endTimestamp, double startLongitude, double startLatitude, double endLongitude, double endLatitude, LocationState locationState, boolean realtimeOnly, NavigationType navigationType)
    {
        //precondition: navigationTable and navigationRealtimeTable are not null and sorted as row key designed

        //initialize variables
        HashMap<String, User> users=new HashMap<String, User>();

        //for each state, real time and batch phase
        boolean[] phases=realtimeOnly? new boolean[] {true}:new boolean[] {true,false};
        
        for(boolean realtimePhase:phases)
        { 
            byte[] startRow=bytesFromHex(hexStartRow);
            byte[] stopRow=bytesFromHex(hexStopRow);
            
            //main loop
            Result firstRow;

            while((firstRow=getNavigationRow(startRow, stopRow, realtimePhase))!=null)
            {
                //extract user name
                byte[] userByte=firstRow.getValue(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_USER));
                if(userByte!=null)
                {
                    String user=Bytes.toString(userByte);
                    
                    //extract navigations
                    Navigation[] navigations=new Navigation[0];
                    
                    if(navigationType!=NavigationType.userName)
                    {
                        if(navigationType==NavigationType.lastPoint)
                        {
                            Navigation navigation=valueOfNavigation(firstRow);
                            
                            //check conditions
                            boolean startTimeRange=(startTimestamp==0 || navigation.getTimpstamp()>=startTimestamp);
                            boolean endTimeRange=(endTimestamp==0 || navigation.getTimpstamp()<endTimestamp);
                            boolean noCoordinate=(startLongitude==0 && endLongitude==0 && startLatitude==0 && endLatitude==0);
                            boolean latitudeRange=(navigation.getLatitude() >=startLatitude && navigation.getLatitude()< endLatitude);
                            boolean longitudeRange=(navigation.getLongitude() >=startLongitude && navigation.getLongitude()< endLongitude);
                            
                            if(startTimeRange && endTimeRange && (noCoordinate || (latitudeRange && longitudeRange)))
                                navigations=new Navigation[] {navigation};     
                        }
                        else
                            navigations=getUserNavigations(user, startTimestamp, endTimestamp, startLongitude, startLatitude, endLongitude, endLatitude, locationState, realtimePhase);

                        //check unique user in hash map
                        if(users.containsKey(user))
                        {
                            User userObject=users.get(user);

                            if(navigationType==NavigationType.lastPoint)
                            {
                                //depending on pre_sorted rows by inverse time stamp
                                if((navigations.length>0 && realtimePhase) || userObject.getNavigations().length==0)
                                    userObject.setNavigations(navigations);
                            }
                            else
                            {
                                Navigation[] allNavigations=new Navigation[userObject.getNavigations().length+navigations.length];

                                for(int i=0;i<userObject.getNavigations().length;i++)
                                    allNavigations[i]=userObject.getNavigations()[i];

                                for(int i=0;i<navigations.length;i++)
                                    allNavigations[i+userObject.getNavigations().length]=navigations[i];

                                userObject.setNavigations(allNavigations);
                            }     
                        }
                        else
                        {
                            User userObject=new User();
                            userObject.setName(user);
                            userObject.setNavigations(navigations);
                            users.put(user, userObject);
                        }  
                    }
                    else
                    {
                        User userObject=new User();
                        userObject.setName(user);
                        users.put(user, userObject);
                    }
                    
                    //new offset value
                    startRow=Bytes.padTail(Bytes.toBytes(user.hashCode()+1), Bytes.SIZEOF_LONG);
                }
            }   
        }
        
        return users.values().toArray(new User[0]);
    }
    
