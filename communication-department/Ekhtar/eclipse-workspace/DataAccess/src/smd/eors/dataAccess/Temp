        report.setMac(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_MAC)),""));
        report.setGpsLatitude(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_LATITUDE)),0d));
        report.setGpsLongitude(valueOfBytes(result.getValue(Bytes.toBytes(DataSchema.REPORT_INFO), Bytes.toBytes(DataSchema.REPORT_INFO_LONGITUDE)),0d));
