        //row key design
        byte[] rowId=command.designRowId();
        command.setRowId(rowId);
        
        //put the value
        Put put=new Put(command.getRowId());
        
        put.addColumn(Bytes.toBytes(DataSchema.COMMAND_INFO), Bytes.toBytes(DataSchema.COMMAND_INFO_ID), Bytes.toBytes(command.getCommandId()));
        put.addColumn(Bytes.toBytes(DataSchema.COMMAND_INFO), Bytes.toBytes(DataSchema.COMMAND_INFO_ADMIN), Bytes.toBytes(command.getAdmin()));
        put.addColumn(Bytes.toBytes(DataSchema.COMMAND_INFO), Bytes.toBytes(DataSchema.COMMAND_INFO_TEXT), Bytes.toBytes(command.getText()));
        put.addColumn(Bytes.toBytes(DataSchema.COMMAND_INFO), Bytes.toBytes(DataSchema.COMMAND_INFO_USERS), Bytes.toBytes(command.getUsers()));
           
        //put the navigation info table
        try
        {
            commandTable.put(put);
        }
        catch (IOException ex)
        {
            if(logStream!=null)
                logStream.writeLog(ex,new Parameter("commandId",command.getCommandId())
                        , new Parameter("admin",command.getAdmin()), new Parameter("text",command.getText())
                        , new Parameter("date",command.getDate().toString()), new Parameter("users",command.getUsers()));
            return false;
        }
        
        return true;
    }
   
