    public static boolean putNavigation(Navigation navigation)
    {        
        //precondition: none
        
        //row key design
        byte[] rowId=navigation.designRowId();
        
        navigation.setRowId(rowId);
        
        //put the value
        Put put=new Put(navigation.getRowId());
        
        put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_USER), Bytes.toBytes(navigation.getUser()));
        put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_LONGITUDE), Bytes.toBytes(navigation.getLongitude()));
        put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_LATITUDE), Bytes.toBytes(navigation.getLatitude()));
        put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_DATE), Bytes.toBytes(navigation.getDate().getTime()));
        
        if(navigation.isGps())
            put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_ACCURACY), Bytes.toBytes(navigation.getAccuracy()));
        else
        {
