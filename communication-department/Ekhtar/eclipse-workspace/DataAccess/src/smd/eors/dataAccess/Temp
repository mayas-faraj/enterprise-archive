    public Filter getExtendedReportCoordinateFilter(double startLongitude, double startLatitude, double endLongitude, double endLatitude)
    {
        //precondition: none
        if(startLongitude!=0 || endLongitude!=0 || startLatitude !=0 || endLatitude!=0)
        {
            //check value range
            if(startLongitude>endLongitude)
            {
                double temp=startLongitude;
                startLongitude=endLongitude;
                endLongitude=temp;
            }
            
            if(startLatitude>endLatitude)
            {
                double temp=startLatitude;
                startLatitude=endLatitude;
                endLatitude=temp;
            }
            
            //setup coordinate filter
            SingleColumnValueFilter startLogitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LONGITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLongitude));
            SingleColumnValueFilter endLongitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LONGITUDE),CompareOp.LESS,Bytes.toBytes(endLongitude));
            SingleColumnValueFilter startLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LATITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLatitude));
            SingleColumnValueFilter endLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_LATITUDE),CompareOp.LESS,Bytes.toBytes(endLatitude));
            SingleColumnValueFilter startCellLogitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLONGITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLongitude));
            SingleColumnValueFilter endCellLongitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLONGITUDE),CompareOp.LESS,Bytes.toBytes(endLongitude));
            SingleColumnValueFilter startCellLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLATITUDE),CompareOp.GREATER_OR_EQUAL,Bytes.toBytes(startLatitude));
            SingleColumnValueFilter endCellLatitudeFilter=new SingleColumnValueFilter(Bytes.toBytes(DataSchema.REPORT_INFO),Bytes.toBytes(DataSchema.REPORT_INFO_CELLLATITUDE),CompareOp.LESS,Bytes.toBytes(endLatitude));
        
            startLogitudeFilter.setFilterIfMissing(true);
            endLongitudeFilter.setFilterIfMissing(true);
            startLatitudeFilter.setFilterIfMissing(true);
            endLatitudeFilter.setFilterIfMissing(true);
            startCellLogitudeFilter.setFilterIfMissing(true);
            endCellLongitudeFilter.setFilterIfMissing(true);
            startCellLatitudeFilter.setFilterIfMissing(true);
            endCellLatitudeFilter.setFilterIfMissing(true);
            
            FilterList gpsFilters=new FilterList(Operator.MUST_PASS_ALL);
            FilterList cellFilters=new FilterList(Operator.MUST_PASS_ALL);
            
            gpsFilters.addFilter(startLogitudeFilter);
            gpsFilters.addFilter(endLongitudeFilter);
            gpsFilters.addFilter(startLatitudeFilter);
            gpsFilters.addFilter(endLatitudeFilter);
            cellFilters.addFilter(startCellLogitudeFilter);
            cellFilters.addFilter(endCellLongitudeFilter);
            cellFilters.addFilter(startCellLatitudeFilter);
            cellFilters.addFilter(endCellLatitudeFilter);
    
            FilterList coordinateFilter=new FilterList(Operator.MUST_PASS_ONE);
            coordinateFilter.addFilter(gpsFilters);
            coordinateFilter.addFilter(cellFilters);
            
            return coordinateFilter;
        }
        else
            return null;
    }

    
