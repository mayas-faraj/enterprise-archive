            put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_AZIMUTH), Bytes.toBytes(navigation.getAzimuth()));
            put.addColumn(Bytes.toBytes(DataSchema.NAVIGATION_INFO), Bytes.toBytes(DataSchema.NAVIGATION_INFO_HEIGHT), Bytes.toBytes(navigation.getHeight()));
            
        }
        
