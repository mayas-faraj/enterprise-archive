        package smd.eors.dataparser;

import java.io.IOException;
import java.util.Date;

import org.apache.commons.cli.BasicParser;
import org.apache.commons.cli.CommandLine;
import org.apache.commons.cli.CommandLineParser;
import org.apache.commons.cli.HelpFormatter;
import org.apache.commons.cli.Option;
import org.apache.commons.cli.Options;
import org.apache.commons.cli.ParseException;

import smd.eors.dataAccess.entity.master.CoverageCell;
import smd.eors.dataAccess.entity.master.ExtendedReport;
import smd.eors.dataAccess.entity.master.Navigation;
import smd.eors.dataaccess.DataAccess;
import smd.eors.dataaccess.entity.CellCoordinate;
import smd.log.LogStream;

public class Program
{  
    public static void main(String[] args) throws IOException
    {
        args="--input /storage/hadoop/Documents/kafka_consumer --log /logs/parser_final.log".split(" ");

        //define options
        Option inputOption=new Option("", "input", true, "The path of the input directory that contains input files.");
        Option zookeeperOption=new Option("z","zookeeper",true,"the ip address of zookeeper.");
        Option logOption=new Option("l","log",true,"The path of the output log file.");

        inputOption.setRequired(true);

        Options options=new Options();
        options.addOption(inputOption);
        options.addOption(zookeeperOption);
        options.addOption(logOption);

        CommandLineParser clp=new BasicParser();

        CommandLine cl;
        try
        {
            cl = clp.parse(options, args);

            //configure log stream
            if(cl.hasOption(logOption.getLongOpt()))
            {
                logStream=new LogStream(cl.getOptionValue(logOption.getLongOpt()));
                DataAccess.setLogFilePath(cl.getOptionValue(logOption.getLongOpt()));
            }

            //configure  ZooKeeper
            if(cl.hasOption(zookeeperOption.getLongOpt()))
            {
                String zookeeperValue=cl.getOptionValue(zookeeperOption.getLongOpt());
                FileAccess.setZookeeper(zookeeperValue);
                DataAccess.setZookeeperAddress(cl.getOptionValue(zookeeperValue));
            }

            //process the files in the input directory
            String inputPath=cl.getOptionValue(inputOption.getLongOpt());

            writeLog("Getting the file list");
            String[] files=FileAccess.getFiles(inputPath);
            writeLog("(%s) files found in directory",files.length);

            if(files!=null)
            { 
                //for each file
                for(String file: files)
                {
                    writeLog("processing the file %s.",file);

                    //read all lines
                    String[] lines=FileAccess.readLines(file);
                    writeLog("fetching the content of the file %s",file);

                    if(lines!=null)
                    {
                        String extension=FileAccess.getFileExtension(file);


                        switch(extension)
                        {
                        case "report":
                        {
                            System.out.println("Report: "+String.valueOf(lines.length));
                            //process for each line
                            int errors=0;
                            long timestemp=(new Date()).getTime();
                            
                            //generating batch 
                            for(String line:lines)
                            {
                                ExtendedReport report=new ExtendedReport();
                                
                                //writeLog("parsing report...");
                                try
                                {
                                    report.fromJsonString(line);
                                }
                                catch(Exception ex)
                                {
                                    System.out.println(line);
                                    errors++;
                                }
                                //writeLog("report parsed");

                                //calculate coordinate depending on global CGI 
                                if(report.getCellCoordinate()!=null)
                                {
                                    CoverageCell cell=CellProcessor.getCoverageCell(report.getCellCoordinate().getCgi());

                                    if(cell!=null)
                                    {
                                        report.getCellCoordinate().setLongitude(cell.getLongitude());
                                        report.getCellCoordinate().setLatitude(cell.getLatitude());
                                        report.getCellCoordinate().setAccuracy(-1);
                                        report.getCellCoordinate().setAzimuth(cell.getAzimuth());
                                        report.getCellCoordinate().setHeight(cell.getHeight());
                                        report.getCellCoordinate().setAddress(cell.getSiteName());
                                    }
                                }

                                //report words processing
                                if(report.getText()!=null && report.getText()!="")
                                { 
                                    String[] words=WordProcessor.getKeywords(report.getText());
                                    report.setKeyword(WordProcessor.joinWords(words));

                                    //process text to calculate matching for every dictionary
                                    report.setClassifies(WordProcessor.getClassification(words));

                                    //calculate importance
                                    report.setImportance(WordProcessor.calculateImportance(report.getClassifies(), words.length));
                                }

                                report.setId(timestemp++);

                                boolean done=DataAccess.saveReport(report);
                                
                                if(!done)
                                    System.out.println("Error while adding report: " + report.toJsonString());
                            }
                            
                            System.out.println("Errors count: "+ String.valueOf(errors));
                        }
                        break;
                        case "cell":
                        {
                            System.out.println("Cell: "+String.valueOf(lines.length));
                            
                            //process for each line
                            for(String line:lines)
                            {
                                Navigation navigation=new Navigation();

                                navigation.fromJsonString(line);

                                //calculate coordinate depending on global CGI 
                                if(navigation.getCoordinate()!=null && navigation.getCoordinate() instanceof CellCoordinate)
                                {
                                    CoverageCell cell=CellProcessor.getCoverageCell(((CellCoordinate)navigation.getCoordinate()).getCgi());

                                    if(cell!=null)
                                    {
                                        ((CellCoordinate)navigation.getCoordinate()).setLongitude(cell.getLongitude());
                                        ((CellCoordinate)navigation.getCoordinate()).setLatitude(cell.getLatitude());
                                        ((CellCoordinate)navigation.getCoordinate()).setAccuracy(-1);
                                        ((CellCoordinate)navigation.getCoordinate()).setAzimuth(cell.getAzimuth());
                                        ((CellCoordinate)navigation.getCoordinate()).setHeight(cell.getHeight());
                                        ((CellCoordinate)navigation.getCoordinate()).setAddress(cell.getSiteName());
                                    }
                                    //else
                                        //writeLog(((CellCoordinate)navigation.getCoordinate()).getCgi() + " not found!");
                                }

                                boolean done=DataAccess.saveNavigation(navigation);
                                
                                if(!done)
                                    System.out.println("Error while adding report: " + navigation.toJsonString());
                            }
                        }
                        break;
                        case "gps":
                        {
                            System.out.println("GPS: "+String.valueOf(lines.length));
                            //process for each line
                            for(String line:lines)
                            {     
                                Navigation navigation=new Navigation();

                                //writeLog("parsing gps navigation...");
                                navigation.fromJsonGpsString(line);
                                //writeLog("navigation gps parsed");
                                
                                boolean done=DataAccess.saveNavigation(navigation);
                                
                                if(!done)
                                    System.out.println("Error while adding report: " + navigation.toJsonString());
                            }
                        }
                        break;
                        default:
                            writeLog("Unsupported file type %s",file);
                            writeLog("continue");
                            continue;
                        }
                    }   
                }   
            }                    
        }
        catch (ParseException ex)
        {
            ex.printStackTrace();
            HelpFormatter helpFormatter=new HelpFormatter();
            helpFormatter.printHelp("hbase-parser", options);
            return;
        }
        catch (Exception ex)
        {
            writeLog(ex);
            ex.printStackTrace();
        }
    }

    //private static methods region
    private static void writeLog(String text, Object formatArgs)
    {
        if(text!=null)
            text=String.format(text, formatArgs);

        System.out.println(text);

        if(logStream!=null)
            logStream.writeLog(text);
    }

    private static void writeLog(String text)
    {
        writeLog(text, null);
    }

    private static void writeLog(Exception ex)
    {
        ex.printStackTrace();
        writeLog(ex.getMessage());
    }

    //private fields region
    private static LogStream logStream;
}